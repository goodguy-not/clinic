# Copy to `.env` at the repository root. Never commit a real environment file.
#
# This file belongs to the NestJS API and the development database ONLY.
# The web application has its own file: `apps/web/.env.local.example`.
#
# The split is deliberate. NestJS owns PostgreSQL, so DATABASE_URL must never
# reach the Next.js process (CLAUDE.md, Architecture boundary). Nothing loads
# this file into apps/web.

NODE_ENV=development
API_PORT=3001

# Matches docker-compose.yml. Host port is 5433, not 5432, so it cannot collide
# with a locally installed PostgreSQL.
DATABASE_URL=postgresql://clinic:clinic_dev_only@localhost:5433/clinic_dev?schema=public

# Shared secret proving a request reached NestJS through the Next.js server.
# Required, with no default: a default would be a published credential. The API
# refuses to start without it.
#
# The same value must appear in apps/web/.env.local. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The value below is a placeholder for local development only. It is not a
# secret, is not used anywhere, and must never be used outside a dev machine.
INTERNAL_API_KEY=dev_only_placeholder_internal_key_change_me_32

# Optional. Comma-separated clinic-specific terms a password may not contain --
# clinic name, brand words, domain. Owner-supplied at deploy time so no
# clinic-identifying string is committed. Unset means an empty list.
# PASSWORD_BLOCKED_TERMS=
