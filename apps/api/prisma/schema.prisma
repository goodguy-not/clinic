// Milestone 1 — authentication and audit foundation.
// Milestone 2 — clinic reference data: therapists, services, rooms, tariffs.
// Milestone 3 — families, guardians, children, and the transient registration
//               draft that carries a submission across a duplicate warning.
//
// PostgreSQL-native constraints that Prisma cannot express — CHECK, partial
// indexes, exclusion constraints, composite foreign keys, functions and
// triggers — are hand-written inside the generated migration SQL and pinned by
// tests that assert each object exists by name. Reading this file alone
// therefore understates what the database enforces; read the migration
// alongside it.
//
// That understatement is largest around `Tariff`. Nothing here shows that a
// tariff is immutable after insert, that two tariffs may not cover the same
// service, duration and therapist on overlapping dates, or that a free tariff
// must carry a reason. All three are enforced, in SQL.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  MANAGER
  RECEPTIONIST

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  USER_DISABLED
  MANAGER_REVOKED
  SUPERSEDED

  @@map("session_revoke_reason")
}

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

/// Lifecycle of a catalog record. Shared by therapists, services and rooms:
/// the three have identical lifecycles, and three near-identical enums would
/// be three places to change when that stops being true.
///
/// There is no `DELETED`. Records with history are deactivated, never deleted
/// (PROJECT_SPEC.md 5), and the migration adds triggers so the database
/// refuses a DELETE regardless of what the application asks for.
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}

/// Whether a tariff's family-facing price is a real charge or an intentional
/// zero.
///
/// Explicit, never inferred from `price_toman = 0`. The clinic runs genuinely
/// free programmes — complimentary screening, introductory consultations — and
/// that is a different fact from an ordinarily paid service discounted to
/// nothing for one family. The first is a FREE tariff; the second stays a PAID
/// tariff and is handled by the later discount model, which preserves the
/// original price.
///
/// A FREE tariff states what the family pays and nothing else. What the
/// therapist is paid for a complimentary session is an independent settlement
/// decision and must not be inferred from this column.
enum TariffPriceMode {
  PAID
  FREE

  @@map("tariff_price_mode")
}

/// Lifecycle of a family or child record.
///
/// Deliberately separate from `catalog_status` despite carrying the same two
/// values. A family is not clinic reference data, and the two lifecycles are
/// likely to diverge: a discharged family may one day need a state a treatment
/// room never will. Two structurally identical enums is the cost; merging them
/// under a neutral name stays available if by Milestone 5 they have not
/// diverged.
///
/// There is no `DELETED` and no `ARCHIVED`. Records with history are
/// deactivated (PROJECT_SPEC.md 5), the database refuses a `DELETE` outright,
/// and "archived" means inactive until some report treats the two differently.
enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

/// How a guardian is related to the children in the family.
///
/// A closed list rather than free text, so a report can group by it and so the
/// receptionist answering the phone knows who they are speaking to. `OTHER`
/// carries a required short note, which keeps it from becoming a black hole.
///
/// This is deliberately not a custody or legal-guardianship model. It records
/// who to call. `GUARDIAN` means a caring adult who is not a parent or a
/// grandparent, and implies nothing about legal status.
enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDMOTHER
  GRANDFATHER
  GUARDIAN
  OTHER

  @@map("guardian_relationship")
}

/// Recorded sex of a child.
///
/// `UNSPECIFIED` is a real value and the default, not a missing one: a
/// phone-call registration should never stall on it, and a nullable column
/// would make "not asked yet" indistinguishable from a bug.
enum ChildSex {
  FEMALE
  MALE
  UNSPECIFIED

  @@map("child_sex")
}

/// What a registration draft is holding.
///
/// The draft is addressed by an opaque token and consumed exactly once, so the
/// purpose decides which contract validates its payload on the way out and
/// which write the confirmation performs.
enum DraftPurpose {
  FAMILY_CREATE
  FAMILY_UPDATE
  CHILD_CREATE
  CHILD_UPDATE

  @@map("draft_purpose")
}

/// Staff accounts. Manager-created only; there is no self-registration.
///
/// User rows are permanent historical records: account creation is audited and
/// later financial rows will name the actor. There is no delete endpoint, no
/// delete service method, and the migration adds BEFORE DELETE and BEFORE
/// TRUNCATE triggers so the database refuses one too. Deactivation is
/// `status = DISABLED`.
///
/// There is deliberately no `updatedAt`: Prisma's `@updatedAt` is written by the
/// application clock, and `audit_log` is already the authoritative change
/// history for this table.
model AppUser {
  id                         String     @id @default(uuid(7)) @db.Uuid
  username                   String     @unique
  displayName                String     @map("display_name")
  role                       UserRole
  status                     UserStatus @default(ACTIVE)
  passwordHash               String     @map("password_hash")
  passwordUpdatedAt          DateTime   @default(now()) @map("password_updated_at") @db.Timestamptz
  mustChangePassword         Boolean    @default(true) @map("must_change_password")
  failedLoginCount           Int        @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt DateTime?  @map("failed_login_window_started_at") @db.Timestamptz
  lockedUntil                DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz
  disabledAt                 DateTime?  @map("disabled_at") @db.Timestamptz
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId            String?    @map("created_by_user_id") @db.Uuid

  createdBy    AppUser?      @relation("AppUserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdUsers AppUser[]     @relation("AppUserCreatedBy")
  sessions     UserSession[]
  auditEntries AuditLog[]

  createdTherapists Therapist[]
  createdServices   Service[]
  createdRooms      Room[]
  createdTariffs    Tariff[]

  createdFamilies    Family[]
  createdChildren    Child[]
  registrationDrafts RegistrationDraft[]

  @@map("app_user")
}

/// Server-side session records. The browser holds an opaque token; this table
/// stores only its SHA-256 hash, so a leaked backup or query log yields no
/// usable session.
///
/// Unlike the other two tables this one is operational state, not a historical
/// record, and expired rows are meant to be purgeable. That is only possible
/// because `audit_log.sessionId` carries no foreign key to it.
model UserSession {
  id                String               @id @default(uuid(7)) @db.Uuid
  tokenHash         Bytes                @unique @map("token_hash")
  userId            String               @map("user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz
  revokedReason     SessionRevokeReason? @map("revoked_reason")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("user_session")
}

/// Append-only audit trail. The migration adds BEFORE UPDATE, BEFORE DELETE and
/// BEFORE TRUNCATE triggers; TRUNCATE needs its own because it bypasses
/// row-level triggers entirely.
///
/// Exactly one foreign key exists here, to `actorUserId`, because user rows are
/// permanent. `sessionId`, `entityId` and `entityType` are historical
/// references with no constraint: they must be able to outlive the rows they
/// name, and the audit module must not become coupled to every future table.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz
  action      String
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// Deliberately a plain UUID with no relation, so session retention stays
  /// possible. See the model comment above.
  sessionId   String?        @map("session_id") @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id") @db.Uuid
  before      Json?          @db.JsonB
  after       Json?          @db.JsonB
  metadata    Json?          @db.JsonB
  ip          String?        @db.Inet
  userAgent   String?        @map("user_agent")

  actor AppUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
  @@index([sessionId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Milestone 2 — clinic reference data.
//
// Every row here carries `createdByUserId` as a NOT NULL foreign key. There is
// no anonymous or system path that creates catalog data: it is entered by a
// signed-in manager, and the row names them. `onDelete: Restrict` is belt and
// braces — `app_user` already refuses deletion outright.
//
// None of these tables has `updatedAt`. `audit_log` is the authoritative change
// history, and a second, application-clock timestamp would be a quieter and
// less trustworthy copy of it.
// ---------------------------------------------------------------------------

/// A therapist as clinic reference data.
///
/// Not an account. Therapist login is a later, separately approved decision
/// (PROJECT_SPEC.md 4), so there is no relation to `AppUser`, no credentials
/// and no session. `createdBy` names the manager who entered the record, which
/// is a different fact entirely.
///
/// There is deliberately no share or settlement percentage. PROJECT_SPEC.md 5
/// calls that rule "later" and 16 assigns it to the settlement milestone, where
/// it must be effective-dated and snapshotted onto each completed session — a
/// plain column here would be the wrong shape and would invite writing one.
///
/// Deactivation is `status = INACTIVE`; the migration adds BEFORE DELETE and
/// BEFORE TRUNCATE triggers so the database refuses removal.
model Therapist {
  id              String        @id @default(uuid(7)) @db.Uuid
  fullName        String        @map("full_name")
  specialty       String
  status          CatalogStatus @default(ACTIVE)
  deactivatedAt   DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid

  createdBy         AppUser            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supportedServices TherapistService[]
  tariffs           Tariff[]

  @@index([status])
  @@map("therapist")
}

/// A clinic service, and the session lengths it may be booked for.
///
/// `isPublic` and `publicDescription` are recorded here and read by nothing in
/// this milestone; the public website is a later one. They live on the service
/// because that is where the fact belongs.
model Service {
  id                String        @id @default(uuid(7)) @db.Uuid
  name              String        @unique
  publicDescription String?       @map("public_description")
  isPublic          Boolean       @default(false) @map("is_public")
  status            CatalogStatus @default(ACTIVE)
  deactivatedAt     DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId   String        @map("created_by_user_id") @db.Uuid

  createdBy        AppUser            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  durations        ServiceDuration[]
  therapists       TherapistService[]
  roomRestrictions RoomService[]
  tariffs          Tariff[]

  @@index([status])
  @@map("service")
}

/// One session length a service may be booked for, in whole minutes.
///
/// The `@@unique` is load-bearing beyond preventing duplicates: it is the
/// target of a hand-written composite foreign key from `tariff`, which is what
/// makes "a tariff may only price a duration this service actually offers" a
/// database guarantee rather than a service-layer check.
///
/// That same foreign key is ON DELETE RESTRICT, so a duration cannot be
/// withdrawn while any tariff still prices it — including a voided one. A
/// duration that was ever priced stays a valid historical reference.
model ServiceDuration {
  id              String @id @default(uuid(7)) @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  durationMinutes Int    @map("duration_minutes")

  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tariffs Tariff[] @relation("TariffServiceDuration")

  @@unique([serviceId, durationMinutes])
  @@map("service_duration")
}

/// A treatment room.
model Room {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String        @unique
  status          CatalogStatus @default(ACTIVE)
  deactivatedAt   DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid

  createdBy       AppUser       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allowedServices RoomService[]

  @@index([status])
  @@map("room")
}

/// Services a therapist supports.
///
/// Current configuration, not history: the change is recorded in `audit_log`
/// under `therapist.updated`, so these rows may be replaced freely and cascade
/// with their parents.
model TherapistService {
  therapistId String @map("therapist_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([therapistId, serviceId])
  @@index([serviceId])
  @@map("therapist_service")
}

/// Allow-list of services a room is restricted to. No rows means unrestricted,
/// which is the common case and the one that needs no data entry.
model RoomService {
  roomId    String @map("room_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roomId, serviceId])
  @@index([serviceId])
  @@map("room_service")
}

/// An effective-dated price.
///
/// `therapistId` is NULL for a general tariff — one applying to any therapist
/// providing this service and duration. A therapist-specific tariff takes
/// precedence over a general one for the same date.
///
/// IMMUTABLE AFTER INSERT. A correction voids the row and inserts a
/// replacement rather than editing values in place, so the price that applied
/// on a past date stays readable exactly as it was applied. This is enforced by
/// the `tariff_enforce_immutability` trigger, which permits exactly one
/// transition — active to voided — and refuses every other change, including
/// unvoiding. The service layer is not the only thing standing between a bug
/// and rewritten financial history.
///
/// `priceMode` is explicit and never inferred from `price_toman = 0`; see the
/// `TariffPriceMode` comment. `price_toman` is integer toman in BIGINT
/// (DECISION_LOG, 2026-08-02 — Money unit) and crosses the API as a decimal
/// string, never a JavaScript number.
///
/// `effectiveStart`/`effectiveEnd` are DATE: a calendar day with no time and no
/// offset. A NULL `effectiveEnd` means open-ended. They cross the API as
/// `YYYY-MM-DD` strings — see `src/common/iso-date.ts` for why a `Date` must
/// not escape.
///
/// Family-specific pricing (PROJECT_SPEC.md 5) is absent because families do
/// not exist yet. It arrives as an additive nullable column, not a reshape.
///
/// NOTE: the (serviceId, durationMinutes) -> ServiceDuration composite foreign
/// key is hand-written in the migration, not declared here, because `serviceId`
/// already participates in the single-column relation to `Service` above.
model Tariff {
  id                 String          @id @default(uuid(7)) @db.Uuid
  serviceId          String          @map("service_id") @db.Uuid
  durationMinutes    Int             @map("duration_minutes")
  therapistId        String?         @map("therapist_id") @db.Uuid
  priceMode          TariffPriceMode @map("price_mode")
  priceToman         BigInt          @map("price_toman")
  freeReason         String?         @map("free_reason")
  effectiveStart     DateTime        @map("effective_start") @db.Date
  effectiveEnd       DateTime?       @map("effective_end") @db.Date
  voidedAt           DateTime?       @map("voided_at") @db.Timestamptz
  voidReason         String?         @map("void_reason")
  supersedesTariffId String?         @map("supersedes_tariff_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId    String          @map("created_by_user_id") @db.Uuid

  service          Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceDuration  ServiceDuration @relation("TariffServiceDuration", fields: [serviceId, durationMinutes], references: [serviceId, durationMinutes], onDelete: Restrict, onUpdate: Cascade)
  therapist        Therapist?      @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedesTariff Tariff?         @relation("TariffSupersedes", fields: [supersedesTariffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy     Tariff[]        @relation("TariffSupersedes")
  createdBy        AppUser         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The resolution lookup: service and duration are always known, therapist
  /// may be. Effective dates are filtered after this narrowing, so they are not
  /// part of the index.
  @@index([serviceId, durationMinutes, therapistId])
  @@index([therapistId])
  @@index([supersedesTariffId])
  @@map("tariff")
}

// ---------------------------------------------------------------------------
// Milestone 3 — families, guardians, children.
//
// The first personal data this system stores. Three rules run through all of it.
//
// ON CLOCKS: as in Milestones 1 and 2, PostgreSQL owns every domain timestamp.
// `@default(now())` renders as `DEFAULT CURRENT_TIMESTAMP`, PostgreSQL's exact
// synonym for `transaction_timestamp()`, and the services write these columns
// with `transaction_timestamp()` explicitly in raw SQL. Nothing here obliges a
// future service to pass a JavaScript Date: `created_at`, `deactivated_at` and
// a draft's `created_at` and `expires_at` all come from the transaction clock,
// so a state change and its audit row are provably the same instant and no skew
// between the Node host and the database can appear.
//
// ON SEARCH: every `search_*` column is `fa_normalize()` applied to the column
// beside it, computed inside the INSERT rather than by the application, and
// pinned by a CHECK. One implementation, used identically for what is stored and
// for what is searched. The original text is never rewritten — the folding lives
// only in the derived key.
//
// ON IDENTIFIERS: a national identifier and a phone number are stored in full
// here and nowhere else. `audit_log` receives them masked to their last four
// digits, which `audit_log_masked_identifiers_chk` enforces in the database.
//
// As in Milestone 2, reading this file alone understates what the database
// enforces: the CHECKs, partial unique indexes, functions and triggers are
// hand-written in the migration and pinned by name in an integration test.
// ---------------------------------------------------------------------------

/// A family: the clinic's account unit, and the anchor every search resolves to.
///
/// It carries the surname used as the account's label and nothing else
/// identifying. Every phone number belongs to a named guardian, because "whose
/// number is this?" is the question a receptionist actually has when the phone
/// rings, and a pair of unattributed columns cannot answer it.
///
/// A family has ONE OR MORE guardians, and that is a service invariant rather
/// than a database one. PostgreSQL enforces "at most one primary contact" (a
/// partial unique index) and "the primary is reachable" (a CHECK); "at least one
/// guardian exists" is guaranteed by the contract's `min(1)` and by the fact
/// that guardians are only ever replaced wholesale by a request that must itself
/// carry one.
///
/// A family has ZERO OR MORE children. Registration is two requests, so an
/// interrupted workflow legitimately leaves a family with none. Nothing here
/// claims otherwise.
///
/// Deactivation is `status = INACTIVE`; the migration adds BEFORE DELETE and
/// BEFORE TRUNCATE triggers so the database refuses removal.
model Family {
  id               String       @id @default(uuid(7)) @db.Uuid
  familyName       String       @map("family_name")
  /// `fa_normalize(family_name)`, written in the same statement and pinned by
  /// `family_search_name_chk`.
  searchFamilyName String       @map("search_family_name")
  address          String?
  /// Non-clinical. Clinical records are excluded from the product entirely
  /// (PROJECT_SPEC.md 2), and the interface labels this field accordingly.
  note             String?
  status           RecordStatus @default(ACTIVE)
  deactivatedAt    DateTime?    @map("deactivated_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId  String       @map("created_by_user_id") @db.Uuid

  createdBy AppUser             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guardians Guardian[]
  children  Child[]
  drafts    RegistrationDraft[]

  @@index([status])
  @@index([searchFamilyName])
  @@map("family")
}

/// A guardian: who to call, and nothing more.
///
/// Not a subject of care, not an account, and not a legal record. There is no
/// relation to `AppUser`, no credentials and no session — a guardian is a
/// contact staff manage, exactly as a therapist is a record staff manage.
///
/// These rows are CURRENT CONFIGURATION, not history. They are replaced
/// wholesale with their family inside one transaction, the change is recorded in
/// `audit_log` under `family.updated` as an ordered list of values, and nothing
/// references a guardian id. They therefore cascade with their family and carry
/// no no-delete trigger, exactly like `therapist_service` and `room_service`.
model Guardian {
  id               String               @id @default(uuid(7)) @db.Uuid
  familyId         String               @map("family_id") @db.Uuid
  fullName         String               @map("full_name")
  searchFullName   String               @map("search_full_name")
  relationship     GuardianRelationship
  /// Required when the relationship is `OTHER`, forbidden otherwise.
  relationshipNote String?              @map("relationship_note")
  /// Canonical national form, digits only. Never unique: two families
  /// legitimately share a father's mobile, and a shared number is a duplicate
  /// signal, never a constraint.
  mobile           String?
  landline         String?
  isPrimaryContact Boolean              @map("is_primary_contact")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([familyId])
  @@index([searchFullName])
  @@index([mobile])
  @@index([landline])
  @@map("guardian")
}

/// A child: the person treated, and the subject every future session charge will
/// name.
///
/// Given and family name are separate fields. Two children in one family sharing
/// a given name and a birth date is a duplicate; two children in different
/// families sharing a given name is a coincidence, and telling those apart needs
/// the parts kept apart.
///
/// A CHILD BELONGS PERMANENTLY TO ONE FAMILY. `family_id` is listed in
/// `child_enforce_identity_immutability`, so an ordinary UPDATE — or a psql
/// session — cannot move a child between families. Reassignment rewrites who
/// owes for every session that child has ever had; it must be a designed,
/// audited repair operation belonging to the milestone that owns financial
/// history, not a side effect of an edit form.
///
/// `fileNumber` is server-assigned from `child_file_number_seq` and immutable.
/// The sequence is deliberately NOT attached as a column default: Prisma sees a
/// default and the datamodel would then have to describe it, so the service
/// calls `nextval()` explicitly in its INSERT and drift stays zero.
model Child {
  id                    String       @id @default(uuid(7)) @db.Uuid
  familyId              String       @map("family_id") @db.Uuid
  firstName             String       @map("first_name")
  lastName              String       @map("last_name")
  searchFirstName       String       @map("search_first_name")
  searchLastName        String       @map("search_last_name")
  /// A calendar day with no time and no offset. A future date is refused by the
  /// service against `clinic_date()`, which is Asia/Tehran and `STABLE` — and
  /// therefore not something a CHECK can express.
  birthDate             DateTime     @map("birth_date") @db.Date
  fileNumber            String       @unique @map("file_number")
  /// A number from the clinic's paper files. Independently unique where present,
  /// so both numbering schemes coexist rather than competing for one column.
  legacyPaperFileNumber String?      @map("legacy_paper_file_number")
  /// Optional. The strongest duplicate signal available, and unique where
  /// present — a national identifier names exactly one person. Stored in full
  /// here and masked everywhere it is copied.
  nationalId            String?      @map("national_id")
  sex                   ChildSex     @default(UNSPECIFIED)
  referralSource        String?      @map("referral_source")
  /// Non-clinical, as on `Family`.
  note                  String?
  status                RecordStatus @default(ACTIVE)
  deactivatedAt         DateTime?    @map("deactivated_at") @db.Timestamptz
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId       String       @map("created_by_user_id") @db.Uuid

  /// `Restrict` rather than `Cascade`: a child is a permanent historical record,
  /// and a family cannot be deleted in any case.
  family    Family              @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy AppUser             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  drafts    RegistrationDraft[]

  @@index([familyId])
  @@index([status])
  @@index([searchLastName, searchFirstName])
  @@map("child")
}

/// A registration draft: what somebody typed, held by the server while they
/// decide whether the family they are registering already exists.
///
/// TRANSIENT WORKFLOW STATE, not a domain record. It is deleted on confirmation
/// or discard, expires in ten minutes, is never audited, and carries no
/// append-only or no-delete protection — deletion is how it is meant to end.
/// There is deliberately no draft audit action and no `registration_draft`
/// entity type.
///
/// It exists because a duplicate is only detectable after a submission and a
/// Route Handler cannot render a page, so something must hold the typed values
/// across the confirmation step. That something is a row here rather than a
/// cookie: a signed cookie gives integrity, not confidentiality, and a family
/// with an address, a note and several guardians can exceed practical cookie
/// size limits — failing intermittently, and only for the largest records.
///
/// Only the SHA-256 hash of the token is stored, exactly as `user_session` does,
/// so a leaked backup yields nothing replayable.
///
/// `sessionId` carries NO foreign key, for the same reason `audit_log.sessionId`
/// does not: expired sessions must stay purgeable. It is still mandatory — a
/// draft is always created inside a signed-in session, and that binding is half
/// of what makes one usable only by the person who created it.
///
/// `expiresAt` has no default. The service writes
/// `transaction_timestamp() + interval '10 minutes'`, from the same PostgreSQL
/// transaction clock as `created_at`, so the two can never disagree and no
/// JavaScript clock is involved.
model RegistrationDraft {
  id                String       @id @default(uuid(7)) @db.Uuid
  tokenHash         Bytes        @unique @map("token_hash")
  purpose           DraftPurpose
  createdByUserId   String       @map("created_by_user_id") @db.Uuid
  sessionId         String       @map("session_id") @db.Uuid
  payload           Json         @db.JsonB
  /// The candidates the user was shown, so a duplicate that appeared since can
  /// be told apart from one they already dismissed.
  shownCandidateIds String[]     @map("shown_candidate_ids") @db.Uuid
  targetFamilyId    String?      @map("target_family_id") @db.Uuid
  targetChildId     String?      @map("target_child_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz

  createdBy    AppUser @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetFamily Family? @relation(fields: [targetFamilyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetChild  Child?  @relation(fields: [targetChildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One live draft per user, per session, per purpose — not merely per user.
  /// The same person working in two browsers holds two independent drafts, and
  /// starting one must not silently destroy the other. Replacement within one
  /// session is a single `INSERT … ON CONFLICT DO UPDATE`, so it is atomic and
  /// the previous token stops working the instant it commits.
  @@unique([createdByUserId, sessionId, purpose])
  /// The key the opportunistic expiry sweep uses.
  @@index([expiresAt])
  @@map("registration_draft")
}
