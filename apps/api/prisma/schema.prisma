// Milestone 1 — authentication and audit foundation.
// Milestone 2 — clinic reference data: therapists, services, rooms, tariffs.
// Milestone 3 — families, guardians, children, and the transient registration
//               draft that carries a submission across a duplicate warning.
// Milestone 4 — appointments: the booking, the per-child seat in it, the
//               recurrence series, and therapist availability.
// Milestone 5 — the ledger spine: the session charge a completed seat produces,
//               and the append-only adjustment that reduces it.
// Milestone 6 — money in: the family payment, and the promise to pay that moves
//               no money at all.
// Milestone 7 — dashboard and reports: NO new table, column or rule. Clinic-wide
//               date-keyed reading is a new access pattern over existing rows,
//               so the milestone adds three B-tree indexes and nothing else.
// Milestone 8, checkpoint C2 — therapist settlement configuration: the
//               effective-dated share percentage a therapist takes. ONE table,
//               and it is configuration rather than a settlement fact — nothing
//               here records what any session earned.
//
// PostgreSQL-native constraints that Prisma cannot express — CHECK, partial
// indexes, exclusion constraints, composite foreign keys, functions and
// triggers — are hand-written inside the generated migration SQL and pinned by
// tests that assert each object exists by name. Reading this file alone
// therefore understates what the database enforces; read the migration
// alongside it.
//
// That understatement is largest around `Tariff`. Nothing here shows that a
// tariff is immutable after insert, that two tariffs may not cover the same
// service, duration and therapist on overlapping dates, or that a free tariff
// must carry a reason. All three are enforced, in SQL.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  MANAGER
  RECEPTIONIST

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  USER_DISABLED
  MANAGER_REVOKED
  SUPERSEDED

  @@map("session_revoke_reason")
}

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

/// Lifecycle of a catalog record. Shared by therapists, services and rooms:
/// the three have identical lifecycles, and three near-identical enums would
/// be three places to change when that stops being true.
///
/// There is no `DELETED`. Records with history are deactivated, never deleted
/// (PROJECT_SPEC.md 5), and the migration adds triggers so the database
/// refuses a DELETE regardless of what the application asks for.
enum CatalogStatus {
  ACTIVE
  INACTIVE

  @@map("catalog_status")
}

/// Whether a tariff's family-facing price is a real charge or an intentional
/// zero.
///
/// Explicit, never inferred from `price_toman = 0`. The clinic runs genuinely
/// free programmes — complimentary screening, introductory consultations — and
/// that is a different fact from an ordinarily paid service discounted to
/// nothing for one family. The first is a FREE tariff; the second stays a PAID
/// tariff and is handled by the later discount model, which preserves the
/// original price.
///
/// A FREE tariff states what the family pays and nothing else. What the
/// therapist is paid for a complimentary session is an independent settlement
/// decision and must not be inferred from this column.
enum TariffPriceMode {
  PAID
  FREE

  @@map("tariff_price_mode")
}

/// Lifecycle of a family or child record.
///
/// Deliberately separate from `catalog_status` despite carrying the same two
/// values. A family is not clinic reference data, and the two lifecycles are
/// likely to diverge: a discharged family may one day need a state a treatment
/// room never will. Two structurally identical enums is the cost; merging them
/// under a neutral name stays available if by Milestone 5 they have not
/// diverged.
///
/// There is no `DELETED` and no `ARCHIVED`. Records with history are
/// deactivated (PROJECT_SPEC.md 5), the database refuses a `DELETE` outright,
/// and "archived" means inactive until some report treats the two differently.
enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

/// How a guardian is related to the children in the family.
///
/// A closed list rather than free text, so a report can group by it and so the
/// receptionist answering the phone knows who they are speaking to. `OTHER`
/// carries a required short note, which keeps it from becoming a black hole.
///
/// This is deliberately not a custody or legal-guardianship model. It records
/// who to call. `GUARDIAN` means a caring adult who is not a parent or a
/// grandparent, and implies nothing about legal status.
enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDMOTHER
  GRANDFATHER
  GUARDIAN
  OTHER

  @@map("guardian_relationship")
}

/// Recorded sex of a child.
///
/// `UNSPECIFIED` is a real value and the default, not a missing one: a
/// phone-call registration should never stall on it, and a nullable column
/// would make "not asked yet" indistinguishable from a bug.
enum ChildSex {
  FEMALE
  MALE
  UNSPECIFIED

  @@map("child_sex")
}

/// The lifecycle of an appointment as a booking.
///
/// Level one of the two-level model: this describes the SHARED BOOKING — one
/// therapist, one room, one service, one time range — and says nothing about
/// what any individual child did. That is the participant's `attendance`.
///
/// FOUR VALUES, AND NO MORE. A no-show is not a state of the booking: the room
/// was held and the therapist waited, and the fact that somebody did not arrive
/// belongs to the seat that was empty. It is `AttendanceOutcome.NO_SHOW`.
///
/// `SCHEDULED` and `COMPLETED` occupy the therapist and the room; both
/// cancellations release them, which is what the two exclusion constraints in
/// the migration are conditional on.
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED_BY_FAMILY
  CANCELLED_BY_CLINIC

  @@map("appointment_status")
}

/// What one child did with their seat.
///
/// Level two of the two-level model, and a separate fact from the booking's own
/// lifecycle: a child may fail to arrive for a session that took place.
///
/// `PENDING` is a real value and the default, not a missing one: the
/// receptionist dashboard's "unresolved outcomes" list is this value.
///
/// `NO_SHOW` is here rather than on the booking because it is a fact about one
/// child. It creates no charge until the clinic approves a policy.
enum AttendanceOutcome {
  PENDING
  ATTENDED
  NO_SHOW

  @@map("attendance_outcome")
}

/// How a recurring series is bounded.
///
/// PROJECT_SPEC.md 6 offers exactly two ways to bound a weekly pattern — a
/// number of occurrences or a last date — and a series states one of them. An
/// unbounded series would generate occurrences forever.
enum RecurrenceEnd {
  OCCURRENCE_COUNT
  END_DATE

  @@map("recurrence_end")
}

/// What a registration draft is holding.
///
/// The draft is addressed by an opaque token and consumed exactly once, so the
/// purpose decides which contract validates its payload on the way out and
/// which write the confirmation performs.
enum DraftPurpose {
  FAMILY_CREATE
  FAMILY_UPDATE
  CHILD_CREATE
  CHILD_UPDATE

  @@map("draft_purpose")
}

/// How the money reached the clinic.
///
/// EXACTLY THREE VALUES (DECISION_LOG, 2026-08-15 — The payment method
/// vocabulary is `CASH`, `CARD`, `TRANSFER`). There is no `CHEQUE`: a cheque is
/// an instrument whose lifecycle — presentation, clearing, dishonour — nothing
/// in Milestone 6 models, and admitting the value without it would record as
/// received money that may never arrive. There is no `OTHER` either, because
/// the value that absorbs every unforeseen case is the one no report can ever
/// say anything about.
enum PaymentMethod {
  CASH
  CARD
  TRANSFER

  @@map("payment_method")
}

/// A promise's stored lifecycle: `OPEN`, and the three ways it ends.
///
/// `MISSED` IS DELIBERATELY ABSENT (DECISION_LOG, 2026-08-15 — A promise is a
/// calendar fact with no financial effect). It is an `OPEN` promise whose due
/// date has passed — a fact about the clock, not an event anybody performs —
/// and is derived on read. Storing it would mean a row whose truth depends on a
/// nightly job having run, and which reads wrongly until it does.
enum PaymentPromiseStatus {
  OPEN
  FULFILLED
  RESCHEDULED
  CANCELLED

  @@map("payment_promise_status")
}

/// How the rating act happened.
///
/// `AUTOMATIC` — the server rated the session in the transaction that posted its
/// charge. `EXPLICIT` — a manager rated it by hand afterwards, with a reason.
///
/// IT SAYS HOW THE ACT HAPPENED, NOT WHERE THE PERCENTAGE CAME FROM. Both
/// resolve the same percentage from the therapist's effective-dated share rule
/// covering the SERVICE DATE, and `appliedShareRuleId` is present on both: there
/// is no per-session override rate in this product.
///
/// RECORDED RATHER THAN INFERRED FROM WHETHER A RULE HAPPENS TO MATCH TODAY.
/// Rules are effective-dated and may be voided and replaced, so any question
/// reconstructed from today's configuration has an answer that changes after the
/// fact.
///
/// NEITHER MEMBER MEANS UNRATED. An unrated session has no `SessionSettlement`
/// row at all.
enum SessionRatedVia {
  AUTOMATIC
  EXPLICIT

  @@map("session_rated_via")
}

/// What a materialised line of a CLOSED settlement period is.
///
/// `PRIMARY` is the first and only authoritative settlement of one session.
/// `CORRECTION` is a signed movement reconciling a session already carried by a
/// `PRIMARY` line with what that session is worth now; it lands in a later
/// period, because a closed period is never reopened.
enum SettlementLineType {
  PRIMARY
  CORRECTION

  @@map("settlement_line_type")
}

/// Staff accounts. Manager-created only; there is no self-registration.
///
/// User rows are permanent historical records: account creation is audited and
/// later financial rows will name the actor. There is no delete endpoint, no
/// delete service method, and the migration adds BEFORE DELETE and BEFORE
/// TRUNCATE triggers so the database refuses one too. Deactivation is
/// `status = DISABLED`.
///
/// There is deliberately no `updatedAt`: Prisma's `@updatedAt` is written by the
/// application clock, and `audit_log` is already the authoritative change
/// history for this table.
model AppUser {
  id                         String     @id @default(uuid(7)) @db.Uuid
  username                   String     @unique
  displayName                String     @map("display_name")
  role                       UserRole
  status                     UserStatus @default(ACTIVE)
  passwordHash               String     @map("password_hash")
  passwordUpdatedAt          DateTime   @default(now()) @map("password_updated_at") @db.Timestamptz
  mustChangePassword         Boolean    @default(true) @map("must_change_password")
  failedLoginCount           Int        @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt DateTime?  @map("failed_login_window_started_at") @db.Timestamptz
  lockedUntil                DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz
  disabledAt                 DateTime?  @map("disabled_at") @db.Timestamptz
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId            String?    @map("created_by_user_id") @db.Uuid

  createdBy    AppUser?      @relation("AppUserCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdUsers AppUser[]     @relation("AppUserCreatedBy")
  sessions     UserSession[]
  auditEntries AuditLog[]

  createdTherapists Therapist[]
  createdServices   Service[]
  createdRooms      Room[]
  createdTariffs    Tariff[]

  createdFamilies    Family[]
  createdChildren    Child[]
  registrationDrafts RegistrationDraft[]

  createdAppointments           Appointment[]                    @relation("AppointmentCreatedBy")
  overriddenAppointments        Appointment[]                    @relation("AppointmentAvailabilityOverrideBy")
  createdAppointmentSeries      AppointmentSeries[]
  createdAvailability           TherapistAvailability[]
  createdAvailabilityExceptions TherapistAvailabilityException[]

  createdSessionCharges    SessionCharge[]    @relation("SessionChargeCreatedBy")
  voidedSessionCharges     SessionCharge[]    @relation("SessionChargeVoidedBy")
  createdChargeAdjustments ChargeAdjustment[] @relation("ChargeAdjustmentCreatedBy")
  voidedChargeAdjustments  ChargeAdjustment[] @relation("ChargeAdjustmentVoidedBy")

  createdShareRules TherapistShareRule[] @relation("TherapistShareRuleCreatedBy")
  voidedShareRules  TherapistShareRule[] @relation("TherapistShareRuleVoidedBy")
  ratedSessions     SessionSettlement[]  @relation("SessionSettlementCreatedBy")
  unratedSessions   SessionSettlement[]  @relation("SessionSettlementVoidedBy")
  closedPeriods     SettlementPeriod[]   @relation("SettlementPeriodClosedBy")

  createdPayments         Payment[]        @relation("PaymentCreatedBy")
  voidedPayments          Payment[]        @relation("PaymentVoidedBy")
  createdPaymentPromises  PaymentPromise[] @relation("PaymentPromiseCreatedBy")
  resolvedPaymentPromises PaymentPromise[] @relation("PaymentPromiseResolvedBy")

  @@map("app_user")
}

/// Server-side session records. The browser holds an opaque token; this table
/// stores only its SHA-256 hash, so a leaked backup or query log yields no
/// usable session.
///
/// Unlike the other two tables this one is operational state, not a historical
/// record, and expired rows are meant to be purgeable. That is only possible
/// because `audit_log.sessionId` carries no foreign key to it.
model UserSession {
  id                String               @id @default(uuid(7)) @db.Uuid
  tokenHash         Bytes                @unique @map("token_hash")
  userId            String               @map("user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz
  revokedReason     SessionRevokeReason? @map("revoked_reason")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("user_session")
}

/// Append-only audit trail. The migration adds BEFORE UPDATE, BEFORE DELETE and
/// BEFORE TRUNCATE triggers; TRUNCATE needs its own because it bypasses
/// row-level triggers entirely.
///
/// Exactly one foreign key exists here, to `actorUserId`, because user rows are
/// permanent. `sessionId`, `entityId` and `entityType` are historical
/// references with no constraint: they must be able to outlive the rows they
/// name, and the audit module must not become coupled to every future table.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz
  action      String
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// Deliberately a plain UUID with no relation, so session retention stays
  /// possible. See the model comment above.
  sessionId   String?        @map("session_id") @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id") @db.Uuid
  before      Json?          @db.JsonB
  after       Json?          @db.JsonB
  metadata    Json?          @db.JsonB
  ip          String?        @db.Inet
  userAgent   String?        @map("user_agent")

  actor AppUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
  @@index([sessionId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Milestone 2 — clinic reference data.
//
// Every row here carries `createdByUserId` as a NOT NULL foreign key. There is
// no anonymous or system path that creates catalog data: it is entered by a
// signed-in manager, and the row names them. `onDelete: Restrict` is belt and
// braces — `app_user` already refuses deletion outright.
//
// None of these tables has `updatedAt`. `audit_log` is the authoritative change
// history, and a second, application-clock timestamp would be a quieter and
// less trustworthy copy of it.
// ---------------------------------------------------------------------------

/// A therapist as clinic reference data.
///
/// Not an account. Therapist login is a later, separately approved decision
/// (PROJECT_SPEC.md 4), so there is no relation to `AppUser`, no credentials
/// and no session. `createdBy` names the manager who entered the record, which
/// is a different fact entirely.
///
/// There is deliberately no share or settlement percentage. PROJECT_SPEC.md 5
/// calls that rule "later" and 16 assigns it to the settlement milestone, where
/// it must be effective-dated and snapshotted onto each completed session — a
/// plain column here would be the wrong shape and would invite writing one.
///
/// Deactivation is `status = INACTIVE`; the migration adds BEFORE DELETE and
/// BEFORE TRUNCATE triggers so the database refuses removal.
model Therapist {
  id              String        @id @default(uuid(7)) @db.Uuid
  fullName        String        @map("full_name")
  specialty       String
  status          CatalogStatus @default(ACTIVE)
  deactivatedAt   DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid

  createdBy              AppUser                          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supportedServices      TherapistService[]
  tariffs                Tariff[]
  appointments           Appointment[]
  sessionCharges         SessionCharge[]
  availability           TherapistAvailability[]
  availabilityExceptions TherapistAvailabilityException[]
  shareRules             TherapistShareRule[]
  settlementPeriods      SettlementPeriod[]

  @@index([status])
  @@map("therapist")
}

/// A clinic service, and the session lengths it may be booked for.
///
/// `isPublic` and `publicDescription` are recorded here and read by nothing in
/// this milestone; the public website is a later one. They live on the service
/// because that is where the fact belongs.
model Service {
  id                String        @id @default(uuid(7)) @db.Uuid
  name              String        @unique
  publicDescription String?       @map("public_description")
  isPublic          Boolean       @default(false) @map("is_public")
  status            CatalogStatus @default(ACTIVE)
  deactivatedAt     DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId   String        @map("created_by_user_id") @db.Uuid

  createdBy        AppUser            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  durations        ServiceDuration[]
  therapists       TherapistService[]
  roomRestrictions RoomService[]
  tariffs          Tariff[]
  appointments     Appointment[]
  sessionCharges   SessionCharge[]

  @@index([status])
  @@map("service")
}

/// One session length a service may be booked for, in whole minutes.
///
/// The `@@unique` is load-bearing beyond preventing duplicates: it is the
/// target of a hand-written composite foreign key from `tariff`, which is what
/// makes "a tariff may only price a duration this service actually offers" a
/// database guarantee rather than a service-layer check.
///
/// That same foreign key is ON DELETE RESTRICT, so a duration cannot be
/// withdrawn while any tariff still prices it — including a voided one. A
/// duration that was ever priced stays a valid historical reference.
model ServiceDuration {
  id              String @id @default(uuid(7)) @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  durationMinutes Int    @map("duration_minutes")

  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tariffs        Tariff[]        @relation("TariffServiceDuration")
  appointments   Appointment[]   @relation("AppointmentServiceDuration")
  sessionCharges SessionCharge[] @relation("SessionChargeServiceDuration")

  @@unique([serviceId, durationMinutes])
  @@map("service_duration")
}

/// A treatment room.
model Room {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String        @unique
  status          CatalogStatus @default(ACTIVE)
  deactivatedAt   DateTime?     @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid

  createdBy       AppUser       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allowedServices RoomService[]
  appointments    Appointment[]

  @@index([status])
  @@map("room")
}

/// Services a therapist supports.
///
/// Current configuration, not history: the change is recorded in `audit_log`
/// under `therapist.updated`, so these rows may be replaced freely and cascade
/// with their parents.
model TherapistService {
  therapistId String @map("therapist_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([therapistId, serviceId])
  @@index([serviceId])
  @@map("therapist_service")
}

/// Allow-list of services a room is restricted to. No rows means unrestricted,
/// which is the common case and the one that needs no data entry.
model RoomService {
  roomId    String @map("room_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roomId, serviceId])
  @@index([serviceId])
  @@map("room_service")
}

/// An effective-dated price.
///
/// `therapistId` is NULL for a general tariff — one applying to any therapist
/// providing this service and duration. A therapist-specific tariff takes
/// precedence over a general one for the same date.
///
/// IMMUTABLE AFTER INSERT. A correction voids the row and inserts a
/// replacement rather than editing values in place, so the price that applied
/// on a past date stays readable exactly as it was applied. This is enforced by
/// the `tariff_enforce_immutability` trigger, which permits exactly one
/// transition — active to voided — and refuses every other change, including
/// unvoiding. The service layer is not the only thing standing between a bug
/// and rewritten financial history.
///
/// `priceMode` is explicit and never inferred from `price_toman = 0`; see the
/// `TariffPriceMode` comment. `price_toman` is integer toman in BIGINT
/// (DECISION_LOG, 2026-08-02 — Money unit) and crosses the API as a decimal
/// string, never a JavaScript number.
///
/// `effectiveStart`/`effectiveEnd` are DATE: a calendar day with no time and no
/// offset. A NULL `effectiveEnd` means open-ended. They cross the API as
/// `YYYY-MM-DD` strings — see `src/common/iso-date.ts` for why a `Date` must
/// not escape.
///
/// Family-specific pricing (PROJECT_SPEC.md 5) is absent because families do
/// not exist yet. It arrives as an additive nullable column, not a reshape.
///
/// NOTE: the (serviceId, durationMinutes) -> ServiceDuration composite foreign
/// key is hand-written in the migration, not declared here, because `serviceId`
/// already participates in the single-column relation to `Service` above.
model Tariff {
  id                 String          @id @default(uuid(7)) @db.Uuid
  serviceId          String          @map("service_id") @db.Uuid
  durationMinutes    Int             @map("duration_minutes")
  therapistId        String?         @map("therapist_id") @db.Uuid
  priceMode          TariffPriceMode @map("price_mode")
  priceToman         BigInt          @map("price_toman")
  freeReason         String?         @map("free_reason")
  effectiveStart     DateTime        @map("effective_start") @db.Date
  effectiveEnd       DateTime?       @map("effective_end") @db.Date
  voidedAt           DateTime?       @map("voided_at") @db.Timestamptz
  voidReason         String?         @map("void_reason")
  supersedesTariffId String?         @map("supersedes_tariff_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId    String          @map("created_by_user_id") @db.Uuid

  service          Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceDuration  ServiceDuration @relation("TariffServiceDuration", fields: [serviceId, durationMinutes], references: [serviceId, durationMinutes], onDelete: Restrict, onUpdate: Cascade)
  therapist        Therapist?      @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedesTariff Tariff?         @relation("TariffSupersedes", fields: [supersedesTariffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy     Tariff[]        @relation("TariffSupersedes")
  createdBy        AppUser         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessionCharges   SessionCharge[]

  /// The resolution lookup: service and duration are always known, therapist
  /// may be. Effective dates are filtered after this narrowing, so they are not
  /// part of the index.
  @@index([serviceId, durationMinutes, therapistId])
  @@index([therapistId])
  @@index([supersedesTariffId])
  @@map("tariff")
}

// ---------------------------------------------------------------------------
// Milestone 3 — families, guardians, children.
//
// The first personal data this system stores. Three rules run through all of it.
//
// ON CLOCKS: as in Milestones 1 and 2, PostgreSQL owns every domain timestamp.
// `@default(now())` renders as `DEFAULT CURRENT_TIMESTAMP`, PostgreSQL's exact
// synonym for `transaction_timestamp()`, and the services write these columns
// with `transaction_timestamp()` explicitly in raw SQL. Nothing here obliges a
// future service to pass a JavaScript Date: `created_at`, `deactivated_at` and
// a draft's `created_at` and `expires_at` all come from the transaction clock,
// so a state change and its audit row are provably the same instant and no skew
// between the Node host and the database can appear.
//
// ON SEARCH: every `search_*` column is `fa_normalize()` applied to the column
// beside it, computed inside the INSERT rather than by the application, and
// pinned by a CHECK. One implementation, used identically for what is stored and
// for what is searched. The original text is never rewritten — the folding lives
// only in the derived key.
//
// ON IDENTIFIERS: a national identifier and a phone number are stored in full
// here and nowhere else. `audit_log` receives them masked to their last four
// digits, which `audit_log_masked_identifiers_chk` enforces in the database.
//
// As in Milestone 2, reading this file alone understates what the database
// enforces: the CHECKs, partial unique indexes, functions and triggers are
// hand-written in the migration and pinned by name in an integration test.
// ---------------------------------------------------------------------------

/// A family: the clinic's account unit, and the anchor every search resolves to.
///
/// It carries the surname used as the account's label and nothing else
/// identifying. Every phone number belongs to a named guardian, because "whose
/// number is this?" is the question a receptionist actually has when the phone
/// rings, and a pair of unattributed columns cannot answer it.
///
/// A family has ONE OR MORE guardians, and that is a service invariant rather
/// than a database one. PostgreSQL enforces "at most one primary contact" (a
/// partial unique index) and "the primary is reachable" (a CHECK); "at least one
/// guardian exists" is guaranteed by the contract's `min(1)` and by the fact
/// that guardians are only ever replaced wholesale by a request that must itself
/// carry one.
///
/// A family has ZERO OR MORE children. Registration is two requests, so an
/// interrupted workflow legitimately leaves a family with none. Nothing here
/// claims otherwise.
///
/// Deactivation is `status = INACTIVE`; the migration adds BEFORE DELETE and
/// BEFORE TRUNCATE triggers so the database refuses removal.
model Family {
  id               String       @id @default(uuid(7)) @db.Uuid
  familyName       String       @map("family_name")
  /// `fa_normalize(family_name)`, written in the same statement and pinned by
  /// `family_search_name_chk`.
  searchFamilyName String       @map("search_family_name")
  address          String?
  /// Non-clinical. Clinical records are excluded from the product entirely
  /// (PROJECT_SPEC.md 2), and the interface labels this field accordingly.
  note             String?
  status           RecordStatus @default(ACTIVE)
  deactivatedAt    DateTime?    @map("deactivated_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId  String       @map("created_by_user_id") @db.Uuid

  createdBy      AppUser             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guardians      Guardian[]
  children       Child[]
  drafts         RegistrationDraft[]
  sessionCharges SessionCharge[]
  /// Money is received from a FAMILY, never from a child: charges identify the
  /// child, payments move the family's position as a whole (DECISION_LOG,
  /// 2026-08-15 — A payment is a family fact).
  payments       Payment[]
  promises       PaymentPromise[]

  @@index([status])
  @@index([searchFamilyName])
  @@map("family")
}

/// A guardian: who to call, and nothing more.
///
/// Not a subject of care, not an account, and not a legal record. There is no
/// relation to `AppUser`, no credentials and no session — a guardian is a
/// contact staff manage, exactly as a therapist is a record staff manage.
///
/// These rows are CURRENT CONFIGURATION, not history. They are replaced
/// wholesale with their family inside one transaction, the change is recorded in
/// `audit_log` under `family.updated` as an ordered list of values, and nothing
/// references a guardian id. They therefore cascade with their family and carry
/// no no-delete trigger, exactly like `therapist_service` and `room_service`.
model Guardian {
  id               String               @id @default(uuid(7)) @db.Uuid
  familyId         String               @map("family_id") @db.Uuid
  fullName         String               @map("full_name")
  searchFullName   String               @map("search_full_name")
  relationship     GuardianRelationship
  /// Required when the relationship is `OTHER`, forbidden otherwise.
  relationshipNote String?              @map("relationship_note")
  /// Canonical national form, digits only. Never unique: two families
  /// legitimately share a father's mobile, and a shared number is a duplicate
  /// signal, never a constraint.
  mobile           String?
  landline         String?
  isPrimaryContact Boolean              @map("is_primary_contact")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([familyId])
  @@index([searchFullName])
  @@index([mobile])
  @@index([landline])
  @@map("guardian")
}

/// A child: the person treated, and the subject every future session charge will
/// name.
///
/// Given and family name are separate fields. Two children in one family sharing
/// a given name and a birth date is a duplicate; two children in different
/// families sharing a given name is a coincidence, and telling those apart needs
/// the parts kept apart.
///
/// A CHILD BELONGS PERMANENTLY TO ONE FAMILY. `family_id` is listed in
/// `child_enforce_identity_immutability`, so an ordinary UPDATE — or a psql
/// session — cannot move a child between families. Reassignment rewrites who
/// owes for every session that child has ever had; it must be a designed,
/// audited repair operation belonging to the milestone that owns financial
/// history, not a side effect of an edit form.
///
/// `fileNumber` is server-assigned from `child_file_number_seq` and immutable.
/// The sequence is deliberately NOT attached as a column default: Prisma sees a
/// default and the datamodel would then have to describe it, so the service
/// calls `nextval()` explicitly in its INSERT and drift stays zero.
model Child {
  id                    String       @id @default(uuid(7)) @db.Uuid
  familyId              String       @map("family_id") @db.Uuid
  firstName             String       @map("first_name")
  lastName              String       @map("last_name")
  searchFirstName       String       @map("search_first_name")
  searchLastName        String       @map("search_last_name")
  /// A calendar day with no time and no offset. A future date is refused by the
  /// service against `clinic_date()`, which is Asia/Tehran and `STABLE` — and
  /// therefore not something a CHECK can express.
  birthDate             DateTime     @map("birth_date") @db.Date
  fileNumber            String       @unique @map("file_number")
  /// A number from the clinic's paper files. Independently unique where present,
  /// so both numbering schemes coexist rather than competing for one column.
  legacyPaperFileNumber String?      @map("legacy_paper_file_number")
  /// Optional. The strongest duplicate signal available, and unique where
  /// present — a national identifier names exactly one person. Stored in full
  /// here and masked everywhere it is copied.
  nationalId            String?      @map("national_id")
  sex                   ChildSex     @default(UNSPECIFIED)
  referralSource        String?      @map("referral_source")
  /// Non-clinical, as on `Family`.
  note                  String?
  status                RecordStatus @default(ACTIVE)
  deactivatedAt         DateTime?    @map("deactivated_at") @db.Timestamptz
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId       String       @map("created_by_user_id") @db.Uuid

  /// `Restrict` rather than `Cascade`: a child is a permanent historical record,
  /// and a family cannot be deleted in any case.
  family           Family                   @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        AppUser                  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  drafts           RegistrationDraft[]
  appointmentSeats AppointmentParticipant[]
  sessionCharges   SessionCharge[]          @relation("SessionChargeChild")

  /// Supports the composite foreign key from `session_charge`, and exists for
  /// no other reason. `id` alone is already the primary key, so this adds no
  /// uniqueness the table did not have; what it adds is a target PostgreSQL can
  /// reference, which is what makes "the charged child belongs to the charged
  /// family" a database guarantee rather than a service-layer join.
  @@unique([id, familyId])
  @@index([familyId])
  @@index([status])
  @@index([searchLastName, searchFirstName])
  @@map("child")
}

/// A registration draft: what somebody typed, held by the server while they
/// decide whether the family they are registering already exists.
///
/// TRANSIENT WORKFLOW STATE, not a domain record. It is deleted on confirmation
/// or discard, expires in ten minutes, is never audited, and carries no
/// append-only or no-delete protection — deletion is how it is meant to end.
/// There is deliberately no draft audit action and no `registration_draft`
/// entity type.
///
/// It exists because a duplicate is only detectable after a submission and a
/// Route Handler cannot render a page, so something must hold the typed values
/// across the confirmation step. That something is a row here rather than a
/// cookie: a signed cookie gives integrity, not confidentiality, and a family
/// with an address, a note and several guardians can exceed practical cookie
/// size limits — failing intermittently, and only for the largest records.
///
/// Only the SHA-256 hash of the token is stored, exactly as `user_session` does,
/// so a leaked backup yields nothing replayable.
///
/// `sessionId` carries NO foreign key, for the same reason `audit_log.sessionId`
/// does not: expired sessions must stay purgeable. It is still mandatory — a
/// draft is always created inside a signed-in session, and that binding is half
/// of what makes one usable only by the person who created it.
///
/// `expiresAt` has no default. The service writes
/// `transaction_timestamp() + interval '10 minutes'`, from the same PostgreSQL
/// transaction clock as `created_at`, so the two can never disagree and no
/// JavaScript clock is involved.
model RegistrationDraft {
  id                String       @id @default(uuid(7)) @db.Uuid
  tokenHash         Bytes        @unique @map("token_hash")
  purpose           DraftPurpose
  createdByUserId   String       @map("created_by_user_id") @db.Uuid
  sessionId         String       @map("session_id") @db.Uuid
  payload           Json         @db.JsonB
  /// The candidates the user was shown, so a duplicate that appeared since can
  /// be told apart from one they already dismissed.
  shownCandidateIds String[]     @map("shown_candidate_ids") @db.Uuid
  targetFamilyId    String?      @map("target_family_id") @db.Uuid
  targetChildId     String?      @map("target_child_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz

  createdBy    AppUser @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetFamily Family? @relation(fields: [targetFamilyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetChild  Child?  @relation(fields: [targetChildId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One live draft per user, per session, per purpose — not merely per user.
  /// The same person working in two browsers holds two independent drafts, and
  /// starting one must not silently destroy the other. Replacement within one
  /// session is a single `INSERT … ON CONFLICT DO UPDATE`, so it is atomic and
  /// the previous token stops working the instant it commits.
  @@unique([createdByUserId, sessionId, purpose])
  /// The key the opportunistic expiry sweep uses.
  @@index([expiresAt])
  @@map("registration_draft")
}

// ---------------------------------------------------------------------------
// Milestone 4 — appointments.
//
// FIVE TABLES, STRUCTURE ONLY. `appointment` and `appointment_participant` are
// the two-level spine (DECISION_LOG, 2026-08-02); `appointment_series` carries
// a weekly recurrence; `therapist_availability` and
// `therapist_availability_exception` carry recurring working windows plus dated
// exceptions (PROJECT_SPEC.md 5).
//
// This checkpoint builds the SCHEMA for all five and the BEHAVIOUR of none.
// There is no booking, no occurrence generation, no availability check and no
// group-booking rule. The tables exist now so that the checkpoints that add
// those behaviours do not each open with a migration, and so the spine is
// settled before any history exists.
//
// NO FINANCIAL COLUMN APPEARS ANYWHERE HERE. There is no tariff reference, no
// price snapshot, no tariff source, no charge, no discount and no amount of any
// kind. Pricing a session is Milestone 5's, and a read-only tariff suggestion
// arrives in a later checkpoint of this milestone as a lookup, not as stored
// state.
//
// TWO FACTS, NOT ONE. `appointment.status` is the booking's lifecycle;
// `appointment_participant.attendance` is what one child did. They are recorded
// separately and neither is derived from the other — a child may be absent from
// a session that took place.
//
// WHAT POSTGRESQL ENFORCES AND THIS FILE DOES NOT SHOW: the window arithmetic
// (`ends_at = starts_at + duration_minutes`), therapist and room overlap as two
// exclusion constraints, and the pairing of every outcome timestamp with its
// status. Read the migration alongside this.
//
// WHAT POSTGRESQL DELIBERATELY DOES NOT ENFORCE: a child booked into two
// overlapping sessions. The child is on the participant and the time is on the
// appointment, so no single-row constraint can see both. It is recomputed in SQL
// under a transaction-scoped advisory lock when a seat is written, exactly as
// the blocking duplicate rules are (DECISION_LOG, 2026-08-09), and that belongs
// to the booking checkpoint.
//
// ON CLOCKS: as in every earlier milestone, PostgreSQL owns the record's own
// timestamps — `created_at` and the outcome timestamps come from
// `transaction_timestamp()`. `starts_at` is different in kind: it is a time
// somebody chose, supplied by the caller, and is the one timestamp here that is
// not a clock reading.
// ---------------------------------------------------------------------------

/// A booking: one therapist, one room, one service, one time range.
///
/// `endsAt` is stored rather than computed so the exclusion constraints can
/// range over it, and a CHECK requires it to equal
/// `startsAt + durationMinutes`, so it is never a second fact that can disagree
/// with the first.
///
/// `durationMinutes` carries a composite foreign key to `ServiceDuration`, so an
/// appointment can only be booked for a session length the service actually
/// offers — the same guarantee, and the same mechanism, as `Tariff`.
///
/// Each outcome timestamp is paired with exactly one status by a CHECK, so a
/// `SCHEDULED` row cannot carry a cancellation and a cancelled one cannot lack a
/// reason.
///
/// `seriesId` is null for a one-off appointment. Every occurrence of a recurring
/// series is an ordinary row here and stays independently traceable
/// (PROJECT_SPEC.md 6) — the series groups them, it does not own them.
///
/// Appointments are permanent historical records: a cancelled one stays visible
/// in the appointment report. There is no delete endpoint and the migration adds
/// BEFORE DELETE and BEFORE TRUNCATE triggers, exactly as for `family` and
/// `child`. Provenance — `id`, `createdAt`, `createdByUserId` — is immutable by
/// trigger.
model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  serviceId       String            @map("service_id") @db.Uuid
  durationMinutes Int               @map("duration_minutes")
  therapistId     String            @map("therapist_id") @db.Uuid
  roomId          String            @map("room_id") @db.Uuid
  /// The instant the session starts. Supplied by the caller, read by the clinic
  /// in Asia/Tehran, and converted to Jalali by the web tier at its own edge.
  startsAt        DateTime          @map("starts_at") @db.Timestamptz
  endsAt          DateTime          @map("ends_at") @db.Timestamptz
  status          AppointmentStatus @default(SCHEDULED)
  seriesId        String?           @map("series_id") @db.Uuid
  /// Non-clinical, as on `Family` and `Child`.
  note            String?

  /// Each of these is required by exactly the status it names and forbidden by
  /// every other one. There is no no-show timestamp: a no-show is one child's
  /// outcome and lives on the seat.
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason String?   @map("cancellation_reason")

  /// The one approved override: booking outside the therapist's availability
  /// (PROJECT_SPEC.md 5). All three move together — a CHECK requires the reason,
  /// the actor and the instant to be present or absent as one fact — so a
  /// half-recorded override cannot exist. There is deliberately no equivalent for
  /// a therapist, room or child conflict: those are hard blocks.
  availabilityOverrideReason   String?   @map("availability_override_reason")
  availabilityOverrideByUserId String?   @map("availability_override_by_user_id") @db.Uuid
  availabilityOverrideAt       DateTime? @map("availability_override_at") @db.Timestamptz

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String   @map("created_by_user_id") @db.Uuid

  service                Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceDuration        ServiceDuration    @relation("AppointmentServiceDuration", fields: [serviceId, durationMinutes], references: [serviceId, durationMinutes], onDelete: Restrict, onUpdate: Cascade)
  therapist              Therapist          @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  room                   Room               @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  series                 AppointmentSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              AppUser            @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Named relations, because `app_user` is now referenced twice from this table.
  /// The names are Prisma's own bookkeeping and appear in no SQL: both foreign
  /// keys are named after their column, exactly as they were before.
  availabilityOverrideBy AppUser?           @relation("AppointmentAvailabilityOverrideBy", fields: [availabilityOverrideByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  participants AppointmentParticipant[]

  /// The day view: every appointment in a time range, whatever its status.
  @@index([startsAt])
  /// One therapist's or one room's day. The exclusion constraints build GIST
  /// indexes on the same columns, but only over occupying statuses, so they
  /// cannot answer "show me everything, including what was cancelled".
  @@index([therapistId, startsAt])
  @@index([roomId, startsAt])
  @@index([serviceId])
  /// "This and all future occurrences", which is a series operation.
  @@index([seriesId, startsAt])
  @@map("appointment")
}

/// One child's seat in a booking.
///
/// THE FAMILY IS REACHED THROUGH THE CHILD and is deliberately not repeated
/// here. A child belongs permanently to one family — `child.family_id` is
/// immutable by trigger — so a second copy could only ever be a way for the two
/// to disagree about who was treated.
///
/// THERE IS NO PRICE ON THIS ROW. What a session costs the family is Milestone
/// 5's, and inventing a column for it now would put an amount in the database
/// before the rules that produce it are approved.
///
/// `attendance` is this seat's own outcome and is a separate fact from
/// `appointment.status`. The rule that only an attended participant in a
/// completed appointment may carry a primary session charge is enforced where
/// charges are created, which is not this milestone.
///
/// "An individual appointment has exactly one participant" is a SERVICE
/// invariant, not a database one, exactly as "a family has at least one
/// guardian" is. A unique index on `appointmentId` would express it, and would
/// also collapse this into a one-to-one relation and undo the two-level
/// structure this milestone establishes.
model AppointmentParticipant {
  id                   String            @id @default(uuid(7)) @db.Uuid
  appointmentId        String            @map("appointment_id") @db.Uuid
  childId              String            @map("child_id") @db.Uuid
  attendance           AttendanceOutcome @default(PENDING)
  attendanceRecordedAt DateTime?         @map("attendance_recorded_at") @db.Timestamptz

  appointment    Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  child          Child           @relation(fields: [childId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessionCharges SessionCharge[] @relation("SessionChargeParticipant")

  /// Supports the composite foreign key from `session_charge`, and exists for
  /// no other reason. It does NOT make a seat unique per appointment — `id` is
  /// already the primary key, so this index is unique on a superset of a key
  /// that is unique already, and a group booking still holds as many seats as
  /// it has children. What it adds is a target PostgreSQL can reference, which
  /// is what makes "the charged participant belongs to the charged
  /// appointment" a database guarantee.
  @@unique([id, appointmentId])
  @@index([appointmentId])
  /// The key the child-conflict recomputation reads, joined to `appointment`
  /// for the window. Also one child's session history.
  @@index([childId])
  @@map("appointment_participant")
}

/// A weekly recurring series.
///
/// The series is an IDENTITY AND A TERMINATION RULE, not a template. The pattern
/// — therapist, room, service, duration, time of day — lives on the occurrences
/// it generated, because PROJECT_SPEC.md 6 requires each occurrence to stay
/// independently traceable and editable. Storing the pattern twice would let a
/// series describe something none of its occurrences match.
///
/// `endMode` says which bound applies, and a CHECK requires exactly the matching
/// column to be present. An unbounded series would generate occurrences forever.
///
/// `intervalWeeks` is 1 for every week and 2 for every second week. Weekly
/// patterns are what PROJECT_SPEC.md 6 approves; nothing here expresses monthly
/// or daily recurrence.
model AppointmentSeries {
  id              String        @id @default(uuid(7)) @db.Uuid
  intervalWeeks   Int           @default(1) @map("interval_weeks")
  startsOn        DateTime      @map("starts_on") @db.Date
  endMode         RecurrenceEnd @map("end_mode")
  occurrenceCount Int?          @map("occurrence_count")
  endsOn          DateTime?     @map("ends_on") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid

  createdBy    AppUser       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@map("appointment_series")
}

/// A therapist's recurring working window on one weekday.
///
/// `weekday` is the clinic's own numbering: 0 is SATURDAY, 6 is Friday, because
/// the Iranian week begins on Saturday and that is the order a schedule is read
/// and printed in. It is the shared product contract (`weekdaySchema` in
/// `@clinic/contracts`) and is deliberately NOT PostgreSQL's `EXTRACT(DOW)`,
/// which begins on Sunday. Native DOW is translated at the boundary that reads
/// an instant — `(EXTRACT(DOW FROM ts AT TIME ZONE 'Asia/Tehran')::int + 1) % 7`
/// — and never stored.
///
/// `startTime` and `endTime` are wall-clock times in the clinic's timezone, not
/// instants: "Saturdays, 09:00 to 13:00" is the fact being recorded, and it does
/// not move when a particular date does.
///
/// CURRENT CONFIGURATION, NOT EFFECTIVE-DATED. A window is a weekday and two
/// times; it applies whenever it is asked about. The rows are replaced as a set
/// when a manager edits the schedule, and the set that was replaced is preserved
/// in `audit_log` under `therapist_availability.updated` rather than in this
/// table.
///
/// `effectiveFrom` and `effectiveTo` were created with this table for
/// effective-dated hours and are DROPPED by the availability migration: that
/// capability is not approved, and columns kept "in case" are how one arrives by
/// accident. Dated facts live in `TherapistAvailabilityException`, which carries
/// a single date rather than a range.
///
/// Two windows may not describe the same therapist's same weekday over
/// overlapping hours: an EXCLUDE constraint in the availability migration
/// refuses that, so one week has one reading. Two blocks on the same day — a
/// morning and an evening — remain legitimate.
model TherapistAvailability {
  id              String   @id @default(uuid(7)) @db.Uuid
  therapistId     String   @map("therapist_id") @db.Uuid
  weekday         Int
  startTime       DateTime @map("start_time") @db.Time
  endTime         DateTime @map("end_time") @db.Time
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String   @map("created_by_user_id") @db.Uuid

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy AppUser   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([therapistId, weekday])
  @@map("therapist_availability")
}

/// A dated exception to the recurring windows: one day off, or one extra window.
///
/// `isAvailable = false` closes the whole day and carries no times. `true` adds
/// a window outside the ordinary pattern and requires them. A CHECK pairs the
/// two, so an exception cannot be half-stated.
///
/// Unlike the windows themselves these are single-day facts, so they carry a
/// date rather than an effective range. They accumulate rather than being
/// replaced: an exception is added and removed one at a time, and both are
/// audited against the therapist.
///
/// One EXCLUDE constraint in the availability migration treats a closed day as
/// the whole day, so a date cannot be closed twice, cannot carry two overlapping
/// extra windows, and cannot be both closed and open.
model TherapistAvailabilityException {
  id              String    @id @default(uuid(7)) @db.Uuid
  therapistId     String    @map("therapist_id") @db.Uuid
  exceptionDate   DateTime  @map("exception_date") @db.Date
  isAvailable     Boolean   @map("is_available")
  startTime       DateTime? @map("start_time") @db.Time
  endTime         DateTime? @map("end_time") @db.Time
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String    @map("created_by_user_id") @db.Uuid

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy AppUser   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([therapistId, exceptionDate])
  @@map("therapist_availability_exception")
}

// ---------------------------------------------------------------------------
// Milestone 5, checkpoint A1 — the ledger spine.
//
// TWO TABLES, STRUCTURE ONLY. `session_charge` is what a completed, attended
// seat costs a family; `charge_adjustment` is an append-only reduction of one
// charge. This checkpoint builds the schema for both and the behaviour of
// neither: there is no charge-posting service, no endpoint, no permission and
// no family account read. The tables exist now so the checkpoints that add
// those behaviours do not each open with a migration, and so the financial
// spine is settled before any money exists.
//
// NO FINANCIAL COLUMN IS ADDED TO `appointment` OR `appointment_participant`,
// and none ever will be. The Milestone 4 boundary holds: a booking is a
// booking, and THE CHARGE ROW IS THE FINANCIAL SNAPSHOT. The tariff stays a
// read-only suggestion at booking time (DECISION_LOG, 2026-08-13) and becomes a
// stored amount only here, at the completion that creates money.
//
// NOTHING HERE IS A PAYMENT. There is no payment, no credit, no allocation, no
// promise, no balance and no therapist share or settlement percentage. Those
// are Milestones 6 and 8, and a column for any of them would be state stored
// before its rules are approved — the mistake this milestone's predecessor
// deliberately avoided.
//
// WHAT POSTGRESQL ENFORCES AND THIS FILE DOES NOT SHOW: at most one non-voided
// charge per seat (a partial unique index), the clinic-borne-only discount
// policy and its split identity, the effective-charge floor with its parent-row
// lock, and the immutability of both tables. Read the migration alongside this.
//
// ON CLOCKS: as in every earlier milestone, PostgreSQL owns the record's own
// timestamps. `service_date` is different in kind — it is the clinic calendar
// day the session happened on, `clinic_date(appointment.starts_at)`, a derived
// snapshot rather than a clock reading.
// ---------------------------------------------------------------------------

/// What one completed, attended seat costs one family.
///
/// THE PRIMARY SESSION CHARGE, and in Milestone 5 the only kind of charge there
/// is. There is deliberately no `type` column: a second charge kind would be a
/// vocabulary invented before anything needs it, and the exactly-once index
/// below reads more honestly without one.
///
/// EVERY COLUMN HERE IS A SNAPSHOT. `amount_toman` is what the family was
/// charged on the day, not what the tariff says today: correcting a tariff
/// never rewrites a charge (CLAUDE.md, non-negotiable rules), so `tariff_id`
/// records which price was applied and the amount records what it was. The two
/// are deliberately not constrained to agree — the tariff may since have been
/// voided and replaced, and the charge must still read as it was raised.
///
/// `price_mode` is carried for the same reason it is carried on `Tariff`, and
/// keeps the same meaning: a FREE session is a genuinely complimentary one and
/// stays structurally distinct from a PAID session later adjusted to zero. A
/// FREE charge is zero and, because an adjustment may not take a charge below
/// zero, can never be adjusted at all.
///
/// FOUR THINGS THE DATABASE PROVES:
///
///   * the charged child belongs to the charged family —
///     `(child_id, family_id)` -> `child`;
///   * the charged participant belongs to the charged appointment —
///     `(appointment_participant_id, appointment_id)` -> `appointment_participant`,
///     which is also what keeps `appointment_id` traceable to a real booking;
///   * the charged service, therapist and session length are real catalog
///     records, and the length is one the service actually offers —
///     `service_id` -> `service`, `therapist_id` -> `therapist`, and
///     `(service_id, duration_minutes)` -> `service_duration`, the same three
///     guarantees, and the same mechanism, as `Tariff`;
///   * at most one non-voided charge exists per seat — a partial unique index,
///     which is what makes repeated completions idempotent.
///
/// WHAT THE DATABASE DELIBERATELY DOES NOT PROVE is that the snapshotted
/// service, therapist and length still match the appointment's CURRENT
/// placement. They must not: a charge may be voided, its completed appointment
/// reopened, and the reopened booking legitimately moved to another therapist
/// or another length. The voided charge has to keep saying what the session it
/// represented actually was, and it must not pin the live booking to a
/// placement it has moved on from. The snapshot points at the catalog records,
/// which are permanent and deactivate-only, not at the mutable placement.
///
/// Void is a one-way door recording actor, instant and reason, exactly as
/// `Tariff`'s is. A voided charge and its replacement both survive: that is how
/// a correction is made, and the trigger permits no other transition.
model SessionCharge {
  id                       String          @id @default(uuid(7)) @db.Uuid
  familyId                 String          @map("family_id") @db.Uuid
  childId                  String          @map("child_id") @db.Uuid
  appointmentId            String          @map("appointment_id") @db.Uuid
  appointmentParticipantId String          @map("appointment_participant_id") @db.Uuid
  serviceId                String          @map("service_id") @db.Uuid
  therapistId              String          @map("therapist_id") @db.Uuid
  durationMinutes          Int             @map("duration_minutes")
  /// The clinic calendar day the session happened on, in Asia/Tehran. A date
  /// with no time and no offset, as `Tariff.effectiveStart` is, so the day a
  /// charge belongs to never depends on the reader's timezone.
  serviceDate              DateTime        @map("service_date") @db.Date
  /// Which price was applied. Not a claim that the tariff still says so.
  tariffId                 String          @map("tariff_id") @db.Uuid
  priceMode                TariffPriceMode @map("price_mode")
  amountToman              BigInt          @map("amount_toman")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId          String          @map("created_by_user_id") @db.Uuid
  voidedAt                 DateTime?       @map("voided_at") @db.Timestamptz
  voidedByUserId           String?         @map("voided_by_user_id") @db.Uuid
  voidReason               String?         @map("void_reason")

  family          Family                 @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  child           Child                  @relation("SessionChargeChild", fields: [childId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
  participant     AppointmentParticipant @relation("SessionChargeParticipant", fields: [appointmentParticipantId, appointmentId], references: [id, appointmentId], onDelete: Restrict, onUpdate: Cascade)
  service         Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceDuration ServiceDuration        @relation("SessionChargeServiceDuration", fields: [serviceId, durationMinutes], references: [serviceId, durationMinutes], onDelete: Restrict, onUpdate: Cascade)
  therapist       Therapist              @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tariff          Tariff                 @relation(fields: [tariffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       AppUser                @relation("SessionChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voidedBy        AppUser?               @relation("SessionChargeVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  adjustments     ChargeAdjustment[]
  /// The applied therapist share snapshots taken from this charge. At most one
  /// is standing at a time (`session_settlement_one_valid_per_charge_uq`); the
  /// rest are withdrawn history.
  settlements     SessionSettlement[] @relation("SessionSettlementCharge")
  /// The closed settlement lines materialised from this charge: at most one
  /// `PRIMARY`, and any number of later `CORRECTION` lines.
  settlementLines SettlementLine[]    @relation("SettlementLineCharge")

  /// Supports the composite foreign key from `session_settlement`, and exists
  /// for no other reason. It constrains nothing the primary key does not
  /// already constrain — `id` leads it — so no charge this table would have
  /// accepted can be refused by it. What it adds is a target PostgreSQL can
  /// reference, which is what makes "the rating's base amount, seat, therapist
  /// and clinic day are the charge's own" a database guarantee rather than a
  /// convention of the service that writes it.
  @@unique([id, appointmentParticipantId, therapistId, serviceDate, amountToman], map: "session_charge_settlement_snapshot_uq")
  /// Supports `settlement_line_charge_snapshot_fkey`. The amount is absent
  /// deliberately: a `CORRECTION` line's `baseAmountToman` is a DELTA and is not
  /// the charge's posted amount, so it cannot be part of the key.
  @@unique([id, appointmentParticipantId, therapistId, serviceDate], map: "session_charge_settlement_line_snapshot_uq")
  /// The family account, which is the read every ledger question starts from.
  @@index([familyId, serviceDate])
  /// Child-level session detail within that account (PROJECT_SPEC.md 7).
  @@index([childId])
  /// One seat's whole charge history, voided rows included — which is exactly
  /// what the partial unique index cannot answer, because it does not index
  /// them.
  @@index([appointmentParticipantId])
  /// Milestone 7: the clinic-wide day, which is a new access pattern. Every
  /// index above is keyed on a family, a child or a seat, so "what did the whole
  /// clinic charge between these two dates" could only be a sequential scan of
  /// every charge ever raised.
  @@index([serviceDate])
  @@map("session_charge")
}

/// An append-only reduction of one session charge: a discount, a waiver, or the
/// freeing of a session that was priced.
///
/// A CORRECTION IS NEVER AN EDIT. The charge is not rewritten and the tariff is
/// not touched; a row is added here, and the family's effective amount is the
/// charge less the adjustments still active against it. That is what keeps the
/// original price, the concession and the reason all readable afterwards
/// (PROJECT_SPEC.md 9).
///
/// EVERY MILESTONE 5 DISCOUNT IS CLINIC-BORNE, and PostgreSQL enforces it:
/// `therapist_discount_toman` must be zero and `clinic_discount_toman` must
/// equal `amount_toman`. The three columns exist in their final shape because
/// the split identity — therapist share plus clinic share equals the family
/// discount — is an approved domain rule (DECISION_LOG, 2026-08-02), and a
/// two-column table would have to be reshaped to honour it later. What is
/// deferred is the ability to record a non-zero therapist share, not the
/// vocabulary for it. A shared or therapist-borne concession is not
/// representable here and must not be disguised as a clinic-borne one.
///
/// THE FAMILY'S EFFECTIVE AMOUNT MAY NEVER GO NEGATIVE. Active adjustments
/// against one charge may not sum past it, and that is enforced under a lock on
/// the parent charge row, so two concurrent adjustments cannot both pass
/// against a stale sum.
///
/// Void is one-way and records actor, instant and reason, exactly as the
/// charge's is. Voiding an adjustment restores the amount it had removed, which
/// is why the floor check reads only non-voided rows.
model ChargeAdjustment {
  id                     String    @id @default(uuid(7)) @db.Uuid
  sessionChargeId        String    @map("session_charge_id") @db.Uuid
  /// The total the family is relieved of. Positive: this table only ever
  /// reduces, and an increase would be a different fact needing its own rules.
  amountToman            BigInt    @map("amount_toman")
  /// Zero in Milestone 5, by CHECK. The column is here because the split is an
  /// approved rule, not because a value other than zero is reachable.
  therapistDiscountToman BigInt    @map("therapist_discount_toman")
  clinicDiscountToman    BigInt    @map("clinic_discount_toman")
  /// Required, unlike the charge's own note-free shape. A concession nobody can
  /// explain is what CLAUDE.md forbids outright.
  reason                 String
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId        String    @map("created_by_user_id") @db.Uuid
  voidedAt               DateTime? @map("voided_at") @db.Timestamptz
  voidedByUserId         String?   @map("voided_by_user_id") @db.Uuid
  voidReason             String?   @map("void_reason")

  sessionCharge SessionCharge @relation(fields: [sessionChargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     AppUser       @relation("ChargeAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voidedBy      AppUser?      @relation("ChargeAdjustmentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sessionChargeId])
  @@map("charge_adjustment")
}

/// Money the clinic received from a family.
///
/// FAMILY-LEVEL, AND ALLOCATED TO NOTHING. A charge identifies a child and a
/// session; a payment moves the family's position as a whole. Milestone 6 adds
/// no `payment_allocation` table and no rule deciding which payment settled
/// which charge (DECISION_LOG, 2026-08-15 — A payment is a family fact).
///
/// THERE IS NO STATUS COLUMN, and there is no stored `PENDING`. The lifecycle
/// is exactly `CONFIRMED → VOIDED` (DECISION_LOG, 2026-08-15), which is the
/// same two-state shape `SessionCharge` already carries, so it is spelled the
/// same way: a payment is confirmed exactly while `voidedAt` is null. A status
/// enum alongside the void triple would be a second account of one fact, and
/// the two can disagree. The wire representation derives the word.
///
/// A PREPAYMENT IS JUST A PAYMENT. There is no `isPrepayment` flag and no
/// stored credit: intent is not observable at the counter, and credit is
/// derived from confirmed payments and valid charges (DECISION_LOG,
/// 2026-08-15 — Credit is derived).
///
/// `receivedOn` is the clinic business day the money arrived. It may be
/// back-dated without limit and may NEVER be in the future — a future receipt
/// is not a payment, it is a promise, and `PaymentPromise` already models one.
/// PostgreSQL enforces that against `clinic_date()`, which is `STABLE` and so
/// cannot appear in a CHECK; the migration uses a trigger.
///
/// Void is one-way and records actor, instant and mandatory reason, exactly as
/// a charge's does. Nothing else about a payment can be rewritten, and no
/// payment is ever deleted.
model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  familyId        String        @map("family_id") @db.Uuid
  amountToman     BigInt        @map("amount_toman")
  method          PaymentMethod
  /// A calendar day with no time and no offset — the clinic's business date,
  /// not a clock reading. `createdAt` records when it was entered, so a
  /// back-dated payment is always visible as one.
  receivedOn      DateTime      @map("received_on") @db.Date
  /// An optional bank or terminal reference. Stored here and deliberately NOT
  /// copied into audit payloads (DECISION_LOG, 2026-08-15 — Payment and promise
  /// audit carries no bank reference).
  reference       String?
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz
  voidedByUserId  String?       @map("voided_by_user_id") @db.Uuid
  voidReason      String?       @map("void_reason")

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy AppUser  @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voidedBy  AppUser? @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// At most one, and PostgreSQL says so: `fulfillingPaymentId` is unique.
  fulfilledPromise PaymentPromise[] @relation("PaymentPromiseFulfilment")

  /// Supports the composite foreign key from `payment_promise`, and exists for
  /// no other reason — `id` alone is already the primary key. It is what makes
  /// "the payment that fulfils a promise belongs to the same family" a database
  /// guarantee rather than a service-layer join, exactly as
  /// `Child.@@unique([id, familyId])` does for a charge.
  @@unique([id, familyId])
  /// The family account read, which is where every payment question starts.
  @@index([familyId, receivedOn])
  /// Milestone 7, and the two indexes are two different questions about the same
  /// row rather than one question written twice.
  ///
  /// `received_on` is the clinic-wide payments report: what the clinic took in
  /// over a period, on the business day the money arrived.
  ///
  /// `created_at` is the DAILY RECONCILIATION — what was ENTERED on a clinic
  /// day, which is what a till is balanced against. It is keyed on the instant
  /// rather than on the entering user, deliberately: a day's entries are few, the
  /// caller's own rows are filtered from that small set, and the manager's
  /// clinic-wide view of the same day reads the same index. A leading
  /// `created_by_user_id` would serve the first read and be useless for the
  /// second.
  @@index([receivedOn])
  @@index([createdAt])
  @@map("payment")
}

/// A family's stated intention to pay: an amount, a day, and nothing that moves
/// money.
///
/// A PROMISE NEVER CHANGES THE FAMILY'S FINANCIAL POSITION, in any state
/// (CLAUDE.md; PROJECT_SPEC.md 8). It carries no allocation, reduces no
/// balance, and the only money it can ever point at is one confirmed payment
/// that stands on its own.
///
/// FULFILMENT IS DATABASE-DEFENSIBLE, not merely service-checked. The linked
/// payment must belong to the same family (composite foreign key), must not be
/// voided, must be at least the promised amount, and may fulfil at most one
/// promise (unique). There is no partial-fulfilment table and no
/// promise-payment allocation rows (DECISION_LOG, 2026-08-15 — A promise is a
/// calendar fact).
///
/// RESCHEDULING PRESERVES THE ORIGINAL. The old promise becomes `RESCHEDULED`
/// and names its successor in the same statement, so a rescheduled promise
/// always has exactly one successor and a promise with a successor is always
/// `RESCHEDULED`. The successor must be `OPEN`, of the same family, and due
/// today or later — an intention already overdue at the moment it is agreed
/// records nothing. An INITIAL promise, by contrast, may be created with a past
/// due date and reads immediately as derived `MISSED` (DECISION_LOG,
/// 2026-08-15 — A promise may be born late).
///
/// TERMINAL IS TERMINAL. `FULFILLED`, `RESCHEDULED` and `CANCELLED` rows cannot
/// transition again, and the amount, due date, family, note and creation facts
/// of any promise are written once. The resolution — its actor, its instant and
/// its reason — is written once with the transition and is frozen with it.
///
/// THERE IS NO `followUpDate` (DECISION_LOG, 2026-08-15). Its semantics were
/// never approved, and a date column with no workflow behind it is a field
/// people fill in and nobody reads.
model PaymentPromise {
  id                     String               @id @default(uuid(7)) @db.Uuid
  familyId               String               @map("family_id") @db.Uuid
  amountToman            BigInt               @map("amount_toman")
  /// The day the family said it would pay. A calendar day, as `receivedOn` is.
  dueOn                  DateTime             @map("due_on") @db.Date
  note                   String?
  status                 PaymentPromiseStatus @default(OPEN)
  /// Set exactly when the status is `FULFILLED`. Unique: one payment fulfils at
  /// most one promise, which is what keeps the evidence unambiguous without the
  /// allocation table Milestone 6 refused.
  fulfillingPaymentId    String?              @unique @map("fulfilling_payment_id") @db.Uuid
  /// Set exactly when the status is `RESCHEDULED`. Unique: a successor succeeds
  /// at most one promise.
  rescheduledToPromiseId String?              @unique @map("rescheduled_to_promise_id") @db.Uuid
  /// Who ended the promise and when. Null exactly while it is `OPEN`.
  resolvedAt             DateTime?            @map("resolved_at") @db.Timestamptz
  resolvedByUserId       String?              @map("resolved_by_user_id") @db.Uuid
  /// WHY the promise ended, and it lives HERE rather than only in an audit row.
  /// Mandatory on `RESCHEDULED` and `CANCELLED` — both are decisions somebody
  /// made about money that was promised and did not arrive as agreed, and the
  /// reason is part of the promise's own history, not a side note about it.
  /// Optional on `FULFILLED`, which needs no explanation, and forbidden while
  /// `OPEN`. Immutable once the transition happens, as everything else on a
  /// terminal promise is.
  resolutionReason       String?              @map("resolution_reason")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId        String               @map("created_by_user_id") @db.Uuid

  family     Family   @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  AppUser  @relation("PaymentPromiseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy AppUser? @relation("PaymentPromiseResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Keyed on the PAIR, so the linked payment provably belongs to this promise's
  /// family. The single-column key would let one family's promise be settled by
  /// another family's money.
  fulfillingPayment Payment? @relation("PaymentPromiseFulfilment", fields: [fulfillingPaymentId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)

  /// The successor this promise was rescheduled into, keyed on the pair for the
  /// same reason: a family's promise is never rescheduled into another family's.
  rescheduledTo   PaymentPromise?  @relation("PaymentPromiseReschedule", fields: [rescheduledToPromiseId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
  rescheduledFrom PaymentPromise[] @relation("PaymentPromiseReschedule")

  /// The target of the self-referencing composite key above.
  @@unique([id, familyId])
  /// A family's promises, newest due date first in practice.
  @@index([familyId, dueOn])
  /// The derived overdue list: `OPEN` promises whose due date has passed. That
  /// read is the only reason `MISSED` needs no column.
  @@index([status, dueOn])
  @@map("payment_promise")
}

// ---------------------------------------------------------------------------
// Milestone 8, checkpoint C2 — the therapist share rule.
//
// ONE TABLE, AND IT IS CONFIGURATION. It records the agreement — what
// percentage of a session's value this therapist takes, between which dates —
// and nothing about any session. What a session earned is the per-session
// snapshot a later checkpoint writes; it is not here, and neither is a
// settlement period, a statement, a payout or a therapist ledger position of
// any kind.
//
// AS UNDERSTATED HERE AS `Tariff` IS. Nothing in this model shows that a share
// rule is immutable after insert, that two live rules may not cover the same
// therapist on overlapping dates, that a percentage is bounded to 0..10000
// basis points, or that a voided row must say why. All four are enforced, in
// SQL, in the C2 migration.
// ---------------------------------------------------------------------------

/// The percentage of a session's value a therapist takes, and when it applied.
///
/// Resolved BY SERVICE DATE and never by the clock: the rule that decides a
/// session is the one whose effective range contains the day the session
/// happened, whatever has been agreed since.
///
/// `shareBasisPoints` is hundredths of one percent, 0..10000 inclusive — an
/// integer, with the unit in the name, so 40 percent is 4000 and can never be
/// read as 40 basis points or carried as a float.
///
/// Immutable once written. A correction voids the row and inserts a
/// replacement naming it through `supersedesShareRuleId`, so the percentage
/// that applied on a past date stays readable exactly as it was applied.
model TherapistShareRule {
  id                    String    @id @default(uuid(7)) @db.Uuid
  therapistId           String    @map("therapist_id") @db.Uuid
  shareBasisPoints      Int       @map("share_basis_points")
  effectiveStart        DateTime  @map("effective_start") @db.Date
  /// Null is an open-ended agreement: in force until something supersedes it.
  effectiveEnd          DateTime? @map("effective_end") @db.Date
  /// The rule this one replaced. Recorded on the replacement, so the history
  /// reads forwards.
  supersedesShareRuleId String?   @map("supersedes_share_rule_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  voidedAt              DateTime? @map("voided_at") @db.Timestamptz
  /// Recorded on the row as well as in `audit_log`, following the financial
  /// tables rather than the catalog ones: "who withdrew this agreement" is a
  /// settlement question that must be answerable from the record itself.
  voidedByUserId        String?   @map("voided_by_user_id") @db.Uuid
  voidReason            String?   @map("void_reason")

  therapist      Therapist            @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes     TherapistShareRule?  @relation("TherapistShareRuleSupersedes", fields: [supersedesShareRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy   TherapistShareRule[] @relation("TherapistShareRuleSupersedes")
  /// The ratings resolved from this rule. Provenance only: the percentage each
  /// applied lives on its own row as a number, and voiding this rule changes
  /// none of them.
  appliedRatings SessionSettlement[]
  createdBy      AppUser              @relation("TherapistShareRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voidedBy       AppUser?             @relation("TherapistShareRuleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The resolution lookup: one therapist's rules, narrowed by date afterwards.
  /// The effective range is not part of the index for the reason `Tariff`'s is
  /// not — a therapist has a handful of rules, and the range filter is a cheap
  /// scan of those.
  @@index([therapistId])
  @@index([supersedesShareRuleId])
  @@map("therapist_share_rule")
}

/// WHAT ONE SESSION EARNED, frozen at the instant somebody rated it.
///
/// THIS IS THE HISTORICAL FACT; `TherapistShareRule` IS THE CONFIGURATION, and
/// the whole milestone rests on not blurring the two. The percentage that
/// applied lives HERE, as a number. `appliedShareRuleId` says where it came
/// from and is nothing more than provenance: voiding, correcting or replacing
/// that rule afterwards changes nothing on this row, and no code re-resolves
/// it. That is what CLAUDE.md means by "historical sessions must preserve the
/// applied percentage as a snapshot".
///
/// UNRATED IS THE ABSENCE OF A ROW. There is no `unrated` flag and no
/// zero-valued placeholder: a placeholder would assert that somebody earned
/// nothing, which is a different claim from nobody having decided yet, and the
/// difference is a therapist's month. A `FREE` session, by contrast, IS rated —
/// it has a row whose base and gross are zero — so "earned nothing" and "not
/// decided yet" are different SHAPES rather than the same number.
///
/// EVERY AMOUNT IS A SNAPSHOT, AND FIVE FACTS ARE THE CHARGE'S OWN. The seat,
/// the therapist, the clinic day and the pre-discount amount are carried by ONE
/// composite foreign key back into `SessionCharge`, so a rating that disagreed
/// with the charge it settles is not merely wrong, it is unwritable.
///
/// `baseAmountToman` IS THE PRE-DISCOUNT CHARGE. Settlement is completed-session
/// value and is independent of whether or when the family pays (CLAUDE.md), so
/// nothing here reads a payment, and a concession is allocated separately rather
/// than by quietly shrinking the basis.
///
/// A RATING IS VOIDED, NEVER EDITED AND NEVER DELETED. A wrong percentage is
/// corrected by withdrawing the row and inserting a replacement that names it,
/// both in one transaction, so the figure that was applied and the figure that
/// replaced it stay readable with an actor and a reason on each.
model SessionSettlement {
  id                            String          @id @default(uuid(7)) @db.Uuid
  sessionChargeId               String          @map("session_charge_id") @db.Uuid
  /// Snapshotted from the charge, with the three below, through one composite
  /// foreign key. Not a convenience copy: it is what lets a settlement
  /// statement group by therapist and clinic day without joining back into the
  /// ledger on every row.
  appointmentParticipantId      String          @map("appointment_participant_id") @db.Uuid
  therapistId                   String          @map("therapist_id") @db.Uuid
  serviceDate                   DateTime        @map("service_date") @db.Date
  appliedShareBasisPoints       Int             @map("applied_share_basis_points")
  /// Provenance, never a pointer to re-read — and never null. A share rule is
  /// the only source of settlement policy in this product, so BOTH kinds of
  /// rating resolve their percentage from the rule covering the service date;
  /// `ratedVia` records who performed the act, not where the number came from.
  appliedShareRuleId            String          @map("applied_share_rule_id") @db.Uuid
  ratedVia                      SessionRatedVia @map("rated_via")
  /// The charge amount as posted, before any concession.
  baseAmountToman               BigInt          @map("base_amount_toman")
  /// `round_half_up(base * bp / 10000)`, with the clinic taking the exact
  /// residual, so the two always sum to the base. Both are stored even though
  /// either could be derived, because storing both keeps that guarantee
  /// readable years later without re-running the rounding rule of the day.
  therapistGrossToman           BigInt          @map("therapist_gross_toman")
  clinicGrossToman              BigInt          @map("clinic_gross_toman")
  /// Null on an `AUTOMATIC` rating and required on an `EXPLICIT` one: a rating
  /// raised by the posting path explains itself, while a manager reaching back
  /// to a session left unrated is deciding about somebody's earnings after the
  /// fact.
  reason                        String?
  /// The rating this one replaced, recorded on the replacement so the history
  /// reads forwards. Null for a first rating.
  supersedesSessionSettlementId String?         @map("supersedes_session_settlement_id") @db.Uuid
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId               String          @map("created_by_user_id") @db.Uuid
  voidedAt                      DateTime?       @map("voided_at") @db.Timestamptz
  voidedByUserId                String?         @map("voided_by_user_id") @db.Uuid
  voidReason                    String?         @map("void_reason")

  charge           SessionCharge       @relation("SessionSettlementCharge", fields: [sessionChargeId, appointmentParticipantId, therapistId, serviceDate, baseAmountToman], references: [id, appointmentParticipantId, therapistId, serviceDate, amountToman], onDelete: Restrict, onUpdate: Cascade, map: "session_settlement_charge_snapshot_fkey")
  appliedShareRule TherapistShareRule  @relation(fields: [appliedShareRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes       SessionSettlement?  @relation("SessionSettlementSupersedes", fields: [supersedesSessionSettlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy     SessionSettlement[] @relation("SessionSettlementSupersedes")
  createdBy        AppUser             @relation("SessionSettlementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voidedBy         AppUser?            @relation("SessionSettlementVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The closed settlement lines this applied rating was materialised into.
  settlementLines SettlementLine[] @relation("SettlementLineRating")

  /// Supports `settlement_line_rating_scope_fkey`, and exists for no other
  /// reason: it constrains nothing the primary key does not already constrain,
  /// and it is what makes "a closed line's rating belongs to the charge that
  /// line settles" a database guarantee.
  @@unique([id, sessionChargeId], map: "session_settlement_charge_scope_uq")
  /// The rating of one session, and its withdrawn history. The uniqueness of
  /// the STANDING one is a partial unique index the migration writes by hand;
  /// Prisma cannot express `WHERE voided_at IS NULL`.
  @@index([sessionChargeId])
  /// What a settlement statement reads: one therapist over a range of clinic
  /// days.
  @@index([therapistId, serviceDate])
  @@index([appliedShareRuleId])
  @@index([supersedesSessionSettlementId])
  @@map("session_settlement")
}

/// A CLOSED settlement period: one therapist, one explicit inclusive range of
/// clinic days, and the figures that close made final (Milestone 8, C6).
///
/// A row exists only because a manager closed the range, so there is no status
/// column and no `OPEN` state — the open period is simply the range no row
/// covers. It is never reopened, never edited and never deleted: the table
/// refuses every UPDATE, and later movement against a session it settled is a
/// new `CORRECTION` line in a LATER period.
///
/// NOTHING HERE IS A PAYOUT. `settledToman` means "closed off in a period", not
/// "paid"; this milestone records no money leaving the clinic.
model SettlementPeriod {
  id                          String   @id @default(uuid(7)) @db.Uuid
  therapistId                 String   @map("therapist_id") @db.Uuid
  /// Both ends inclusive, as calendar days with no time and no offset — the
  /// `SESSION_DATE` basis the statement is read on.
  periodStart                 DateTime @map("period_start") @db.Date
  periodEnd                   DateTime @map("period_end") @db.Date
  /// Sessions this close settled for the first time, historical carry-ins
  /// included. Kept apart from the correction count, because a correction
  /// carried in from an earlier closed period is not work done in this one.
  settledSessionCount         Int      @map("settled_session_count")
  carriedInCorrectionCount    Int      @map("carried_in_correction_count")
  /// Charged sessions inside the range that carried no rating at the instant of
  /// closing. STORED rather than recomputed: recomputing would give a different
  /// answer the moment one of them was rated, and the answer that matters is
  /// the one that was true when the manager closed.
  excludedUnratedSessionCount Int      @map("excluded_unrated_session_count")
  /// This period's own `PRIMARY` lines, and only those, which is why both are
  /// unsigned.
  therapistGrossToman         BigInt   @map("therapist_gross_toman")
  therapistDiscountToman      BigInt   @map("therapist_discount_toman")
  /// Signed: the movements this close carried in from sessions already settled.
  carriedInCorrectionToman    BigInt   @map("carried_in_correction_toman")
  /// The two together, re-derived by `settlement_period_totals_chk`. Signed,
  /// and a negative period is a net settlement figure — never a debt.
  settledToman                BigInt   @map("settled_toman")
  closedAt                    DateTime @default(now()) @map("closed_at") @db.Timestamptz
  closedByUserId              String   @map("closed_by_user_id") @db.Uuid

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closedBy  AppUser   @relation("SettlementPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  lines SettlementLine[]

  /// Supports `settlement_line_period_scope_fkey`, so a line cannot belong to
  /// one therapist's period while naming another therapist.
  @@unique([id, therapistId], map: "settlement_period_therapist_scope_uq")
  /// No two periods of one therapist may overlap. The exclusion constraint that
  /// decides it is written by hand in the migration; Prisma cannot express one.
  @@index([therapistId, periodStart])
  @@map("settlement_period")
}

/// One session's materialised settlement fact inside a closed period.
///
/// A `PRIMARY` line is the session's first and only authoritative settlement and
/// carries LEVELS: what the session was worth, and what each side took, at the
/// instant of closing. A `CORRECTION` line carries a signed DELTA reconciling a
/// session already settled with what it is worth now, and names the `PRIMARY`
/// line it corrects.
///
/// THE INVARIANT THE WHOLE CHECKPOINT RESTS ON: for every session ever settled,
/// the `PRIMARY` line plus every later `CORRECTION` line equals that session's
/// current authoritative settlement figures.
model SettlementLine {
  id                       String             @id @default(uuid(7)) @db.Uuid
  settlementPeriodId       String             @map("settlement_period_id") @db.Uuid
  lineType                 SettlementLineType @map("line_type")
  sessionChargeId          String             @map("session_charge_id") @db.Uuid
  /// The applied rating this line was materialised from. After a rating
  /// correction the replacement is what a later `CORRECTION` line names, and
  /// the withdrawn one stays named by the `PRIMARY` it produced.
  sessionSettlementId      String             @map("session_settlement_id") @db.Uuid
  /// Snapshotted from the charge through one composite foreign key, so the seat,
  /// the therapist and the clinic day on a closed line cannot disagree with the
  /// session they describe. A carry-in keeps its ORIGINAL service date and is
  /// never restated as work done in the period that settled it.
  appointmentParticipantId String             @map("appointment_participant_id") @db.Uuid
  therapistId              String             @map("therapist_id") @db.Uuid
  serviceDate              DateTime           @map("service_date") @db.Date
  /// Copied from the rating, never re-resolved from a share rule.
  appliedShareBasisPoints  Int                @map("applied_share_basis_points")
  ratedVia                 SessionRatedVia    @map("rated_via")
  baseAmountToman          BigInt             @map("base_amount_toman")
  therapistGrossToman      BigInt             @map("therapist_gross_toman")
  therapistDiscountToman   BigInt             @map("therapist_discount_toman")
  therapistNetToman        BigInt             @map("therapist_net_toman")
  clinicGrossToman         BigInt             @map("clinic_gross_toman")
  clinicDiscountToman      BigInt             @map("clinic_discount_toman")
  clinicNetToman           BigInt             @map("clinic_net_toman")
  /// Null on a `PRIMARY` line and required on a `CORRECTION` one: a correction
  /// that named no historical fact would be a signed amount with no way back to
  /// the session it reconciles.
  correctsSettlementLineId String?            @map("corrects_settlement_line_id") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz

  period      SettlementPeriod  @relation(fields: [settlementPeriodId, therapistId], references: [id, therapistId], onDelete: Restrict, onUpdate: Cascade, map: "settlement_line_period_scope_fkey")
  charge      SessionCharge     @relation("SettlementLineCharge", fields: [sessionChargeId, appointmentParticipantId, therapistId, serviceDate], references: [id, appointmentParticipantId, therapistId, serviceDate], onDelete: Restrict, onUpdate: Cascade, map: "settlement_line_charge_snapshot_fkey")
  rating      SessionSettlement @relation("SettlementLineRating", fields: [sessionSettlementId, sessionChargeId], references: [id, sessionChargeId], onDelete: Restrict, onUpdate: Cascade, map: "settlement_line_rating_scope_fkey")
  corrects    SettlementLine?   @relation("SettlementLineCorrects", fields: [correctsSettlementLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctedBy SettlementLine[]  @relation("SettlementLineCorrects")

  /// At most one `PRIMARY` line per session. The partial unique index that
  /// decides it — `WHERE line_type = 'PRIMARY'` — is written by hand in the
  /// migration, because Prisma cannot express a partial index.
  @@index([settlementPeriodId])
  @@index([sessionChargeId])
  @@index([therapistId, serviceDate])
  @@index([sessionSettlementId])
  @@index([correctsSettlementLineId])
  @@map("settlement_line")
}
