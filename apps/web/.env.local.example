# Copy to `apps/web/.env.local`. Never commit a real environment file.
#
# Next.js auto-loads `.env.local` from this directory. Only variables the web
# application genuinely needs belong here.
#
# No database connection variable belongs in this file, and none may be added:
# NestJS owns PostgreSQL and the web application has no database access
# (CLAUDE.md, Architecture boundary). `scripts/check-web-boundary.mjs` fails the
# build if a database variable or package appears anywhere under apps/web —
# including this file, so the check cannot be documented away.

API_BASE_URL=http://localhost:3001
