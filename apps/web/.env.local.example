# Copy to `apps/web/.env.local`. Never commit a real environment file.
#
# Next.js auto-loads `.env.local` from this directory. Only variables the web
# application genuinely needs belong here.
#
# No database connection variable belongs in this file, and none may be added:
# NestJS owns PostgreSQL and the web application has no database access
# (CLAUDE.md, Architecture boundary). `scripts/check-web-boundary.mjs` fails the
# build if a database variable or package appears anywhere under apps/web —
# including this file, so the check cannot be documented away.
#
# Nothing here may be prefixed NEXT_PUBLIC_. Every value below is a secret or a
# security decision, and that prefix would inline it into the browser bundle.
# The boundary check fails the build if one appears.

API_BASE_URL=http://localhost:3001

# Whether this is the real deployment. Required, with no default.
#
#   production      __Host- prefixed, Secure cookies. Requires HTTPS.
#   non-production  unprefixed, non-Secure cookies, for local HTTP and LAN use.
#
# Deliberately independent of NODE_ENV: `next start` forces NODE_ENV=production
# even when you are testing a production build over plain HTTP on a LAN, and
# that is a non-production *deployment*. There is no override flag — the only
# way to get non-Secure cookies is to say so here.
DEPLOYMENT_MODE=non-production

# Must match INTERNAL_API_KEY in the repository-root `.env` used by the API.
# Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=dev_only_placeholder_internal_key_change_me_32

# HMAC key for the session and CSRF cookie signatures. At least 32 characters.
# Rotating it invalidates every live cookie, which is acceptable at a 12-hour
# session cap but does sign everyone out.
SESSION_COOKIE_SECRET=dev_only_placeholder_cookie_secret_change_me_32

# Exact origins accepted on state-changing requests, comma-separated. Matching
# is exact — no wildcards, no suffix rules. Every entry must be https when
# DEPLOYMENT_MODE=production.
#
# Add your machine's LAN origin here when testing from another device, e.g.
#   http://localhost:3000,http://192.168.1.20:3000
WEB_ALLOWED_ORIGINS=http://localhost:3000
